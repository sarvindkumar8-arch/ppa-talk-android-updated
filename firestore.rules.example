rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owns(uid) { return signedIn() && request.auth.uid == uid; }

    function profileIsPublic(uid) {
      return !exists(/databases/$(database)/documents/publicProfiles/$(uid))
        || (
          get(/databases/$(database)/documents/publicProfiles/$(uid)).data.profileVisibility != 'private'
          && get(/databases/$(database)/documents/publicProfiles/$(uid)).data.isPrivate != true
        );
    }

    function isFriend(uid) {
      return signedIn()
        && exists(/databases/$(database)/documents/friends/$(uid)/list/$(request.auth.uid));
    }

    function canViewProfile(uid) {
      return owns(uid) || profileIsPublic(uid) || isFriend(uid);
    }

    function canViewPosts(uid) {
      return canViewProfile(uid);
    }

    function canViewParentPost(postId) {
      return exists(/databases/$(database)/documents/posts/$(postId))
        && canViewPosts(get(/databases/$(database)/documents/posts/$(postId)).data.uid);
    }

    match /users/{uid} {
      allow read: if owns(uid);
      allow create: if owns(uid) && request.resource.data.uid == uid;
      allow update: if owns(uid)
        && request.resource.data.uid == resource.data.uid;
      allow delete: if owns(uid);

      match /savedPosts/{postId} {
        allow read, delete: if owns(uid);
        allow create, update: if owns(uid)
          && request.resource.data.postId == postId
          && request.resource.data.ownerUid is string
          && request.resource.data.keys().hasOnly(['postId', 'ownerUid', 'savedAt']);
      }

      match /fcmTokens/{tokenId} {
        allow read: if owns(uid);
        allow create, update: if owns(uid)
          && request.resource.data.token == tokenId
          && request.resource.data.platform == 'android'
          && request.resource.data.keys().hasOnly(['token', 'platform', 'updatedAt']);
        allow delete: if owns(uid);
      }
    }

    // Private profile data is owner-only. Public profile fields are visibility-gated.
    match /publicProfiles/{uid} {
      allow get: if canViewProfile(uid);
      allow list: if signedIn()
        && (resource.data.profileVisibility == 'public' || owns(uid));
      allow create: if owns(uid)
        && request.resource.data.uid == uid
        && request.resource.data.keys().hasOnly([
          'uid', 'displayName', 'username', 'photoUrl', 'coverPhotoUrl',
          'photoOriginalUrl', 'coverPhotoOriginalUrl', 'bio', 'hobby', 'school',
          'favoritePlace', 'hometown', 'currentCity', 'work', 'education',
          'relationshipStatus', 'interests', 'profileVisibility', 'isPrivate',
          'isOnline', 'lastSeen', 'updatedAt', 'createdAt'
        ]);
      allow update: if owns(uid)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'uid', 'displayName', 'username', 'photoUrl', 'coverPhotoUrl',
          'photoOriginalUrl', 'coverPhotoOriginalUrl', 'bio', 'hobby', 'school',
          'favoritePlace', 'hometown', 'currentCity', 'work', 'education',
          'relationshipStatus', 'interests', 'profileVisibility', 'isPrivate',
          'isOnline', 'lastSeen', 'updatedAt'
        ]);
      allow delete: if owns(uid);
    }

    // Minimal directory cards are readable to signed-in users; never store private fields here.
    match /profileDirectory/{uid} {
      allow read: if signedIn();
      allow create, update: if owns(uid)
        && request.resource.data.uid == uid
        && request.resource.data.keys().hasOnly([
          'uid', 'displayName', 'username', 'photoUrl', 'coverPhotoUrl',
          'profileVisibility', 'isOnline', 'lastSeen', 'updatedAt'
        ]);
      allow delete: if owns(uid);
    }

    // APK #117 photo-library code also writes this legacy collection name.
    match /publicProfileDirectory/{uid} {
      allow read: if signedIn();
      allow create, update: if owns(uid)
        && (!('uid' in request.resource.data) || request.resource.data.uid == uid)
        && request.resource.data.keys().hasOnly([
          'uid', 'displayName', 'username', 'photoUrl', 'coverPhotoUrl',
          'photoOriginalUrl', 'coverPhotoOriginalUrl', 'updatedAt'
        ]);
      allow delete: if owns(uid);
    }

    match /usernameClaims/{username} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.username == username
        && username.matches('^[a-z0-9_.]{4,20}$')
        && request.resource.data.keys().hasOnly(['uid', 'username', 'createdAt']);
      allow update: if signedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.username == username
        && request.resource.data.keys().hasOnly(['uid', 'username', 'createdAt']);
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    match /phoneAuthCredentials/{credentialId} {
      allow read, write: if false;
    }

    match /posts/{postId} {
      allow get, list: if signedIn() && canViewPosts(resource.data.uid);
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && (
          (request.resource.data.text is string && request.resource.data.text.size() <= 5000)
          || (request.resource.data.mediaUrl is string && request.resource.data.mediaUrl.size() > 0)
          || (request.resource.data.mediaPath is string && request.resource.data.mediaPath.size() > 0)
        );
      allow update: if signedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == resource.data.uid;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;

      match /likes/{likerId} {
        allow read: if canViewParentPost(postId);
        allow create: if canViewParentPost(postId) && owns(likerId)
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.reaction in ['👍', '❤️', '😂', '😢', '😡'];
        allow update: if canViewParentPost(postId) && owns(likerId)
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.reaction in ['👍', '❤️', '😂', '😢', '😡']
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reaction', 'createdAt']);
        allow delete: if canViewParentPost(postId) && owns(likerId);
      }

      match /comments/{commentId} {
        allow read: if canViewParentPost(postId);
        allow create: if canViewParentPost(postId) && signedIn()
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 1000
          && request.resource.data.parentId is string;
        allow update: if canViewParentPost(postId) && signedIn()
          && resource.data.uid == request.auth.uid
          && request.resource.data.uid == resource.data.uid;
        allow delete: if canViewParentPost(postId) && signedIn()
          && resource.data.uid == request.auth.uid;
      }
    }

    match /postReports/{reportId} {
      allow create: if signedIn()
        && request.resource.data.reporterUid == request.auth.uid
        && request.resource.data.postId is string
        && request.resource.data.postOwnerUid is string
        && request.resource.data.keys().hasOnly(['postId', 'postOwnerUid', 'reporterUid', 'createdAt']);
      allow read, update, delete: if false;
    }

    match /stories/{storyId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.authorName is string
        && request.resource.data.mediaUrl is string
        && request.resource.data.mediaType in ['image', 'video'];
      allow update: if false;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    match /friendRequests/{requestId} {
      // Deterministic IDs allow either participant to read even a not-yet-created pair document.
      allow get: if signedIn()
        && (requestId.matches('^' + request.auth.uid + '_.*$')
          || requestId.matches('^.*_' + request.auth.uid + '$')
          || resource.data.fromUid == request.auth.uid
          || resource.data.toUid == request.auth.uid);
      allow list: if signedIn()
        && (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.toUid is string
        && request.resource.data.toUid != request.auth.uid
        && request.resource.data.status == 'pending';
      allow update: if signedIn()
        && request.resource.data.fromUid == resource.data.fromUid
        && request.resource.data.toUid == resource.data.toUid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && (
          (resource.data.toUid == request.auth.uid
            && request.resource.data.status in ['accepted', 'rejected'])
          || (resource.data.fromUid == request.auth.uid
            && resource.data.status == 'rejected'
            && request.resource.data.status == 'pending')
          || ((resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid)
            && resource.data.status == 'accepted'
            && request.resource.data.status == 'rejected')
        );
      allow delete: if signedIn()
        && (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid);
    }

    match /friends/{uid}/list/{friendUid} {
      function acceptedRequestExists() {
        return (existsAfter(/databases/$(database)/documents/friendRequests/$(uid + '_' + friendUid))
          && getAfter(/databases/$(database)/documents/friendRequests/$(uid + '_' + friendUid)).data.status == 'accepted')
          || (existsAfter(/databases/$(database)/documents/friendRequests/$(friendUid + '_' + uid))
          && getAfter(/databases/$(database)/documents/friendRequests/$(friendUid + '_' + uid)).data.status == 'accepted');
      }
      allow read: if owns(uid);
      allow create, update: if signedIn()
        && (request.auth.uid == uid || request.auth.uid == friendUid)
        && acceptedRequestExists()
        && request.resource.data.uid == friendUid;
      allow delete: if signedIn() && (owns(uid) || request.auth.uid == friendUid);
    }

    match /chats/{chatId} {
      function isParticipant() {
        return signedIn() && request.auth.uid in resource.data.participantIds;
      }
      allow get, list: if isParticipant();
      allow create: if signedIn()
        && request.resource.data.participantIds is list
        && request.resource.data.participantIds.size() == 2
        && request.auth.uid in request.resource.data.participantIds;
      allow update: if isParticipant()
        && request.resource.data.participantIds == resource.data.participantIds
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'updatedAt', 'lastMessage', 'lastMessageAt', 'lastSenderUid',
          'autoDeleteSeconds', 'autoDeleteLabel'
        ])
        && (!('autoDeleteSeconds' in request.resource.data)
          || request.resource.data.autoDeleteSeconds in [0, 86400, 604800, 1296000, 2592000]);
      allow delete: if false;

      match /messages/{messageId} {
        function isChatParticipant() {
          return signedIn()
            && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participantIds;
        }
        allow read: if isChatParticipant();
        allow create: if isChatParticipant()
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 4000
          && (!('expireAt' in request.resource.data)
            || request.resource.data.expireAt is timestamp);
        allow update: if false;
        allow delete: if isChatParticipant() && resource.data.uid == request.auth.uid;
      }
    }

    match /callSessions/{callId} {
      function isParticipant() {
        return signedIn()
          && (request.auth.uid == resource.data.callerUid
            || request.auth.uid == resource.data.calleeUid);
      }
      allow create: if signedIn()
        && request.resource.data.callerUid == request.auth.uid
        && request.resource.data.calleeUid is string
        && request.resource.data.calleeUid != request.auth.uid
        && request.resource.data.status == 'ringing'
        && request.resource.data.callType in ['audio', 'video'];
      allow read: if isParticipant();
      allow update: if isParticipant()
        && request.resource.data.callerUid == resource.data.callerUid
        && request.resource.data.calleeUid == resource.data.calleeUid
        && request.resource.data.callType == resource.data.callType
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'offer', 'answer', 'updatedAt', 'endedAt', 'acceptedAt'
        ]);
      allow delete: if false;

      match /callerCandidates/{candidateId} {
        function callParticipant() {
          let call = get(/databases/$(database)/documents/callSessions/$(callId)).data;
          return signedIn() && (request.auth.uid == call.callerUid || request.auth.uid == call.calleeUid);
        }
        allow read: if callParticipant();
        allow create: if signedIn()
          && request.auth.uid == get(/databases/$(database)/documents/callSessions/$(callId)).data.callerUid
          && request.resource.data.candidate is string;
        allow update, delete: if false;
      }
      match /calleeCandidates/{candidateId} {
        function callParticipant() {
          let call = get(/databases/$(database)/documents/callSessions/$(callId)).data;
          return signedIn() && (request.auth.uid == call.callerUid || request.auth.uid == call.calleeUid);
        }
        allow read: if callParticipant();
        allow create: if signedIn()
          && request.auth.uid == get(/databases/$(database)/documents/callSessions/$(callId)).data.calleeUid
          && request.resource.data.candidate is string;
        allow update, delete: if false;
      }
    }
  }
}