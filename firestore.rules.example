rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owns(userId) { return signedIn() && request.auth.uid == userId; }

    function isOwnedMediaPath(path, folder) {
      return path is string
        && path.split('/').size() == 3
        && path.split('/')[0] == folder
        && path.split('/')[1] == request.auth.uid
        && path.split('/')[2].matches('^[A-Za-z0-9_.-]{1,180}
      return signedIn()
        && uidA is string && uidB is string && uidA != uidB
        && (
          exists(/databases/$(database)/documents/friends/$(uidA)/list/$(uidB))
          || exists(/databases/$(database)/documents/friends/$(uidB)/list/$(uidA))
        )
        && (
          (exists(/databases/$(database)/documents/friendRequests/$(uidA + '_' + uidB))
            && get(/databases/$(database)/documents/friendRequests/$(uidA + '_' + uidB)).data.status == 'accepted')
          || (exists(/databases/$(database)/documents/friendRequests/$(uidB + '_' + uidA))
            && get(/databases/$(database)/documents/friendRequests/$(uidB + '_' + uidA)).data.status == 'accepted')
        );
    }

    function canStartChat(uidA, uidB) {
      return areAcceptedFriends(uidA, uidB)
        || (exists(/databases/$(database)/documents/publicProfiles/$(uidA))
          && get(/databases/$(database)/documents/publicProfiles/$(uidA)).data.profileVisibility == 'public')
        || (exists(/databases/$(database)/documents/publicProfiles/$(uidB))
          && get(/databases/$(database)/documents/publicProfiles/$(uidB)).data.profileVisibility == 'public');
    }

    function isAcceptedFriend(ownerUid) {
      return signedIn()
        && exists(/databases/$(database)/documents/friends/$(ownerUid)/list/$(request.auth.uid))
        && (
          (exists(/databases/$(database)/documents/friendRequests/$(ownerUid + '_' + request.auth.uid))
            && get(/databases/$(database)/documents/friendRequests/$(ownerUid + '_' + request.auth.uid)).data.status == 'accepted')
          || (exists(/databases/$(database)/documents/friendRequests/$(request.auth.uid + '_' + ownerUid))
            && get(/databases/$(database)/documents/friendRequests/$(request.auth.uid + '_' + ownerUid)).data.status == 'accepted')
        );
    }

    function profileIsPublic(ownerUid) {
      return exists(/databases/$(database)/documents/publicProfiles/$(ownerUid))
        && get(/databases/$(database)/documents/publicProfiles/$(ownerUid)).data.profileVisibility == 'public';
    }

    function canReadPost(post) {
      return signedIn() && (
        post.uid == request.auth.uid
        || (profileIsPublic(post.uid) && post.get('audience', 'public') == 'public')
        || (isAcceptedFriend(post.uid) && post.get('audience', 'public') in ['public', 'friends'])
      );
    }

    function canReadStory(story) {
      return signedIn() && (
        story.uid == request.auth.uid
        || profileIsPublic(story.uid)
        || isAcceptedFriend(story.uid)
      );
    }

    // Private account/profile data: only the account owner can access it.
    match /users/{userId} {
      // Private account/profile data: clients may edit only app-owned profile fields.
      // Server migration markers and other server-managed fields must never be client-writable.
      function allowedUserFields() {
        return [
          'uid', 'email', 'phoneNumber', 'createdAt', 'updatedAt',
          'dateOfBirth', 'gender', 'hobby', 'school', 'favoritePlace',
          'hometown', 'currentCity', 'work', 'education',
          'relationshipStatus', 'interests', 'photoUrl', 'coverPhotoUrl',
          'photoOriginalUrl', 'coverPhotoOriginalUrl',
          'photoOriginalPath', 'coverPhotoOriginalPath'
        ];
      }
      allow read: if owns(userId);
      allow create: if owns(userId)
        && request.resource.data.uid == userId
        && request.resource.data.keys().hasOnly(allowedUserFields());
      allow update: if owns(userId)
        && resource.data.uid == userId
        && request.resource.data.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'email', 'phoneNumber', 'updatedAt', 'dateOfBirth', 'gender',
          'hobby', 'school', 'favoritePlace', 'hometown', 'currentCity',
          'work', 'education', 'relationshipStatus', 'interests',
          'photoUrl', 'coverPhotoUrl', 'photoOriginalUrl',
          'coverPhotoOriginalUrl', 'photoOriginalPath', 'coverPhotoOriginalPath'
        ])
        && request.resource.data.keys().hasOnly(allowedUserFields());
      allow delete: if owns(userId);

      // Each signed-in user can manage only their own device push tokens.
      // Cloud Functions Admin SDK reads these tokens server-side.
      match /savedPosts/{postId} {
        allow read, delete: if owns(userId);
        allow create, update: if owns(userId)
          && request.resource.data.postId == postId
          && request.resource.data.ownerUid is string
          && request.resource.data.keys().hasOnly(['postId', 'ownerUid', 'savedAt']);
      }

      match /fcmTokens/{tokenId} {
        allow read: if owns(userId);
        allow create, update: if owns(userId)
          && request.resource.data.token == tokenId
          && request.resource.data.platform == 'android'
          && request.resource.data.keys().hasOnly(['token', 'platform', 'updatedAt']);
        allow delete: if owns(userId);
      }
    }

    // Public directory contains only fields safe to show to signed-in users.
    // Never put email, phone, date of birth, gender, or other private details here.
    match /publicProfiles/{userId} {
      function isAcceptedFriend() {
        return signedIn()
          && exists(/databases/$(database)/documents/friends/$(userId)/list/$(request.auth.uid))
          && (
            (exists(/databases/$(database)/documents/friendRequests/$(userId + '_' + request.auth.uid))
              && get(/databases/$(database)/documents/friendRequests/$(userId + '_' + request.auth.uid)).data.status == 'accepted')
            || (exists(/databases/$(database)/documents/friendRequests/$(request.auth.uid + '_' + userId))
              && get(/databases/$(database)/documents/friendRequests/$(request.auth.uid + '_' + userId)).data.status == 'accepted')
          );
      }
      // Missing visibility is denied by default; legacy profiles must be explicitly marked public.
      allow read: if signedIn() && (
        owns(userId)
        || isAcceptedFriend()
        || resource.data.profileVisibility == "public"
      );
      allow create: if owns(userId)
        && request.resource.data.keys().hasOnly([
          'uid', 'displayName', 'username', 'photoUrl', 'coverPhotoUrl', 'photoOriginalUrl', 'coverPhotoOriginalUrl', 'photoOriginalPath', 'coverPhotoOriginalPath', 'bio', 'hobby', 'school', 'favoritePlace', 'hometown', 'currentCity', 'work', 'education', 'relationshipStatus', 'interests', 'profileVisibility', 'updatedAt', 'createdAt'
        ])
        && request.resource.data.uid == userId;
      allow update: if owns(userId)
        && request.resource.data.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'uid', 'displayName', 'username', 'photoUrl', 'coverPhotoUrl', 'photoOriginalUrl', 'coverPhotoOriginalUrl', 'photoOriginalPath', 'coverPhotoOriginalPath', 'bio', 'hobby', 'school', 'favoritePlace', 'hometown', 'currentCity', 'work', 'education', 'relationshipStatus', 'interests', 'profileVisibility', 'isOnline', 'lastSeen', 'updatedAt'
        ])
        // Permit deletion of legacy presence fields only; never permit them to remain.
        && !request.resource.data.keys().hasAny(['isOnline', 'lastSeen']);
      allow delete: if owns(userId);
    }

    // Minimal discoverability card for every account, including private profiles.
    // Contains only name, username, avatar, cover and visibility; no bio or personal details.
    match /profileDirectory/{userId} {
      // Directory metadata remains discoverable, but private-profile bearer
      // photo URLs must never be stored in this broadly readable document.
      allow read: if signedIn();
      allow create: if owns(userId)
        && request.resource.data.uid == userId
        && request.resource.data.keys().hasOnly([
          'uid', 'displayName', 'username', 'photoUrl', 'coverPhotoUrl',
          'profileVisibility', 'updatedAt'
        ])
        && (request.resource.data.profileVisibility == 'public'
          || !request.resource.data.keys().hasAny(['photoUrl', 'coverPhotoUrl']));
      allow update: if owns(userId)
        && resource.data.uid == userId
        && request.resource.data.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'uid', 'displayName', 'username', 'photoUrl', 'coverPhotoUrl',
          'profileVisibility', 'updatedAt'
        ])
        && (request.resource.data.profileVisibility == 'public'
          || !request.resource.data.keys().hasAny(['photoUrl', 'coverPhotoUrl']));
      allow delete: if owns(userId);
    }

    // Presence is isolated from the signed-in-readable profile directory.
    // Only the owner and accepted friends can read a user's presence document.
    match /profilePresence/{userId} {
      function isAcceptedFriend() {
        return signedIn()
          && exists(/databases/$(database)/documents/friends/$(userId)/list/$(request.auth.uid))
          && (
            (exists(/databases/$(database)/documents/friendRequests/$(userId + '_' + request.auth.uid))
              && get(/databases/$(database)/documents/friendRequests/$(userId + '_' + request.auth.uid)).data.status == 'accepted')
            || (exists(/databases/$(database)/documents/friendRequests/$(request.auth.uid + '_' + userId))
              && get(/databases/$(database)/documents/friendRequests/$(request.auth.uid + '_' + userId)).data.status == 'accepted')
          );
      }
      allow get: if owns(userId) || isAcceptedFriend();
      allow list: if false;
      allow create, update: if owns(userId)
        && request.resource.data.uid == userId
        && request.resource.data.keys().hasOnly(['uid', 'isOnline', 'lastSeen', 'updatedAt']);
      allow delete: if owns(userId);
    }

    // Username reservations: one document per normalized username.
    // A user can only reserve a name for their own account.
    match /usernameClaims/{username} {
      // The app checks a single username claim; do not allow listing all claims.
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.username == username
        && username.matches('^[a-z0-9_.]{4,20}$')
        && request.resource.data.keys().hasOnly(['uid', 'username', 'createdAt']);
      allow update: if owns(resource.data.uid)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.username == username
        && request.resource.data.keys().hasOnly(['uid', 'username', 'createdAt']);
      allow delete: if owns(resource.data.uid);
    }

    match /phoneAuthCredentials/{credentialId} {
      allow read, write: if false;
    }

    // Story media is visible only to its owner, accepted friends, or public-profile viewers.
    match /stories/{storyId} {
      allow read: if canReadStory(resource.data) && resource.data.expiresAt is timestamp && resource.data.expiresAt > request.time;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          'uid', 'authorName', 'mediaUrl', 'mediaType', 'storagePath', 'createdAt', 'expiresAt'
        ])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.authorName is string
        && request.resource.data.authorName.size() > 0
        && request.resource.data.authorName.size() <= 80
        && request.resource.data.mediaUrl is string
        && request.resource.data.mediaUrl.size() <= 4096
        && request.resource.data.mediaType in ['image', 'video']
        && request.resource.data.createdAt == request.time
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt > request.time
        && request.resource.data.expiresAt <= request.time + duration.value(24, 'h') + duration.value(5, 'm')
        && (!('storagePath' in request.resource.data)
          || request.resource.data.storagePath == ''
          || isOwnedMediaPath(request.resource.data.storagePath, 'stories')
          || isOwnedMediaPath(request.resource.data.storagePath, 'reels'))
        && (request.resource.data.mediaUrl.size() > 0
          || (request.resource.data.storagePath is string && request.resource.data.storagePath.size() > 0));
      allow update: if false;
      allow delete: if owns(resource.data.uid);
    }

    match /posts/{postId} {
      // Enforce each post's audience and the author's profile visibility.
      allow read: if canReadPost(resource.data);
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.authorName is string
        && request.resource.data.authorName.size() > 0
        && request.resource.data.authorName.size() <= 80
        && (!('audience' in request.resource.data)
          || request.resource.data.audience in ['public', 'friends', 'private'])
        && (!('text' in request.resource.data)
          || (request.resource.data.text is string && request.resource.data.text.size() <= 5000))
        && (!('mediaUrl' in request.resource.data)
          || (request.resource.data.mediaUrl is string && request.resource.data.mediaUrl.size() <= 4096))
        && (!('storagePath' in request.resource.data)
          || request.resource.data.storagePath == ''
          || isOwnedMediaPath(request.resource.data.storagePath, 'post_photos')
          || isOwnedMediaPath(request.resource.data.storagePath, 'reels'))
        && ((('text' in request.resource.data) && request.resource.data.text.size() > 0)
          || (('mediaUrl' in request.resource.data) && request.resource.data.mediaUrl.size() > 0)
          || (('storagePath' in request.resource.data) && request.resource.data.storagePath is string && request.resource.data.storagePath.size() > 0));

      // A post's owner identity and audience cannot be changed by editing it.
      allow update: if owns(resource.data.uid)
        && request.resource.data.uid == resource.data.uid
        && (!('audience' in request.resource.data)
          || request.resource.data.audience in ['public', 'friends', 'private'])
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'authorName', 'text', 'mediaUrl', 'mediaType', 'postType', 'audience',
          'location', 'taggedUsers', 'overlayText', 'sticker', 'effect',
          'originalAudioMuted', 'updatedAt'
        ]);
      allow delete: if owns(resource.data.uid);

      match /likes/{likerId} {
        // Parent post access is required before reading or changing reactions.
        allow read: if exists(/databases/$(database)/documents/posts/$(postId))
          && canReadPost(get(/databases/$(database)/documents/posts/$(postId)).data);
        allow create: if owns(likerId)
          && exists(/databases/$(database)/documents/posts/$(postId))
          && canReadPost(get(/databases/$(database)/documents/posts/$(postId)).data)
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.reaction in ['👍', '❤️', '😂', '😢', '😡'];
        allow update: if owns(likerId)
          && exists(/databases/$(database)/documents/posts/$(postId))
          && canReadPost(get(/databases/$(database)/documents/posts/$(postId)).data)
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.reaction in ['👍', '❤️', '😂', '😢', '😡']
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reaction', 'createdAt']);
        allow delete: if owns(likerId)
        && exists(/databases/$(database)/documents/posts/$(postId))
        && canReadPost(get(/databases/$(database)/documents/posts/$(postId)).data);
      }
      match /comments/{commentId} {
        allow read: if exists(/databases/$(database)/documents/posts/$(postId))
          && canReadPost(get(/databases/$(database)/documents/posts/$(postId)).data);
        allow create: if signedIn()
          && exists(/databases/$(database)/documents/posts/$(postId))
          && canReadPost(get(/databases/$(database)/documents/posts/$(postId)).data)
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 1000
          && request.resource.data.parentId == postId;
        allow update: if signedIn()
          && exists(/databases/$(database)/documents/posts/$(postId))
          && canReadPost(get(/databases/$(database)/documents/posts/$(postId)).data)
          && resource.data.uid == request.auth.uid
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.parentId == resource.data.parentId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'updatedAt']);
        allow delete: if signedIn()
          && exists(/databases/$(database)/documents/posts/$(postId))
          && canReadPost(get(/databases/$(database)/documents/posts/$(postId)).data)
          && resource.data.uid == request.auth.uid;
      }
    }

    match /postReports/{reportId} {
      allow create: if signedIn()
        && request.resource.data.reporterUid == request.auth.uid
        && request.resource.data.postId is string
        && request.resource.data.postOwnerUid is string
        && request.resource.data.keys().hasOnly(['postId', 'postOwnerUid', 'reporterUid', 'createdAt']);
      allow read, update, delete: if false;
    }

    match /friendRequests/{requestId} {
      // The profile screen listens to both deterministic request IDs. One
      // direction is normally absent, so authorize that exact pair lookup too;
      // otherwise reading a non-existent request is denied before Unfriend opens.
      allow read: if signedIn()
        && (
          requestId.matches('^' + request.auth.uid + '_[^_]+$')
          || requestId.matches('^[^_]+_' + request.auth.uid + '$')
          || resource.data.fromUid == request.auth.uid
          || resource.data.toUid == request.auth.uid
        );
      allow create: if signedIn()
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.toUid is string
        && request.resource.data.toUid != request.auth.uid
        && request.resource.data.status == 'pending';
      allow update: if signedIn() && (
        // Recipient can accept or reject a pending request.
        (resource.data.toUid == request.auth.uid
          && resource.data.status == 'pending'
          && request.resource.data.fromUid == resource.data.fromUid
          && request.resource.data.toUid == resource.data.toUid
          && request.resource.data.status in ['accepted', 'rejected']
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']))
        // Either participant can revoke an accepted friendship.
        || ((resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid)
          && resource.data.status == 'accepted'
          && request.resource.data.fromUid == resource.data.fromUid
          && request.resource.data.toUid == resource.data.toUid
          && request.resource.data.status == 'rejected'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']))
        // Original sender can resend a rejected request.
        || (resource.data.fromUid == request.auth.uid
          && resource.data.status == 'rejected'
          && request.resource.data.fromUid == resource.data.fromUid
          && request.resource.data.toUid == resource.data.toUid
          && request.resource.data.status == 'pending'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']))
      );
      allow delete: if signedIn()
        && (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid);
    }

    match /friends/{userId}/list/{friendId} {
      function hasAcceptedRequest() {
        return (exists(/databases/$(database)/documents/friendRequests/$(userId + '_' + friendId))
          && getAfter(/databases/$(database)/documents/friendRequests/$(userId + '_' + friendId)).data.status == 'accepted')
          || (exists(/databases/$(database)/documents/friendRequests/$(friendId + '_' + userId))
          && getAfter(/databases/$(database)/documents/friendRequests/$(friendId + '_' + userId)).data.status == 'accepted');
      }
      allow read: if owns(userId);
      allow create, update: if signedIn()
        && (request.auth.uid == userId || request.auth.uid == friendId)
        && hasAcceptedRequest();
      // Either participant can remove the friendship from both users' lists.
      allow delete: if signedIn()
        && (owns(userId) || request.auth.uid == friendId);
    }

    match /chats/{chatId} {
      allow read: if signedIn() && request.auth.uid in resource.data.participantIds;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          'participantIds', 'updatedAt', 'lastMessage', 'lastMessageAt', 'lastSenderUid',
          'autoDeleteSeconds', 'autoDeleteLabel',
          'lastReadAt_' + request.auth.uid, 'unreadCount_' + request.auth.uid
        ])
        && request.resource.data.participantIds is list
        && request.resource.data.participantIds.size() == 2
        && request.resource.data.participantIds[0] != request.resource.data.participantIds[1]
        && request.auth.uid in request.resource.data.participantIds
        && canStartChat(request.resource.data.participantIds[0], request.resource.data.participantIds[1]);
      allow update: if signedIn()
        && request.auth.uid in resource.data.participantIds
        && request.resource.data.participantIds == resource.data.participantIds
        && (!('lastSenderUid' in request.resource.data) || request.resource.data.lastSenderUid == request.auth.uid)
        && (!('lastMessage' in request.resource.data) || (request.resource.data.lastMessage is string && request.resource.data.lastMessage.size() <= 4000))
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'updatedAt', 'lastMessage', 'lastMessageAt', 'lastSenderUid',
          'autoDeleteSeconds', 'autoDeleteLabel',
          'lastReadAt_' + request.auth.uid,
          'unreadCount_' + request.auth.uid
        ])
        && (!('autoDeleteSeconds' in request.resource.data)
          || request.resource.data.autoDeleteSeconds in [0, 86400, 604800, 1296000, 2592000]);
      match /messages/{messageId} {
        function isChatParticipant() {
          return signedIn()
            && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participantIds;
        }
        allow read: if isChatParticipant();
        allow create: if isChatParticipant()
          && request.resource.data.keys().hasOnly(['uid', 'text', 'createdAt', 'expireAt'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 4000
          && (!('expireAt' in request.resource.data)
            || (request.resource.data.expireAt is timestamp
              && request.resource.data.expireAt > request.time
              && request.resource.data.expireAt <= request.time + duration.value(30, 'd')));
        allow update: if false;
        allow delete: if isChatParticipant() && resource.data.uid == request.auth.uid;
      }
    }
    // WebRTC call signalling. Firestore stores call metadata, SDP and ICE
    // candidates; audio/video media is not stored in Firestore.
    match /callSessions/{callId} {
      function isParticipant() {
        return signedIn()
          && (request.auth.uid == resource.data.callerUid
            || request.auth.uid == resource.data.calleeUid);
      }
      function isCaller() {
        return signedIn() && request.auth.uid == resource.data.callerUid;
      }
      function isCallee() {
        return signedIn() && request.auth.uid == resource.data.calleeUid;
      }
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          'callerUid', 'calleeUid', 'status', 'callType', 'offer', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.callerUid == request.auth.uid
        && request.resource.data.calleeUid is string
        && request.resource.data.calleeUid != request.auth.uid
        && areAcceptedFriends(request.auth.uid, request.resource.data.calleeUid)
        && request.resource.data.status == 'ringing'
        && request.resource.data.callType in ['audio', 'video'];
      allow read: if isParticipant();
      allow update: if isParticipant()
        && request.resource.data.callerUid == resource.data.callerUid
        && request.resource.data.calleeUid == resource.data.calleeUid
        && request.resource.data.callType == resource.data.callType
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'offer', 'answer', 'updatedAt', 'endedAt', 'acceptedAt'
        ])
        && (
          (isCaller()
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['offer', 'status', 'updatedAt', 'endedAt'])
            && (request.resource.data.status == resource.data.status
              || request.resource.data.status == 'ended'))
          ||
          (isCallee()
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['answer', 'status', 'updatedAt', 'acceptedAt', 'endedAt'])
            && (request.resource.data.status == resource.data.status
              || request.resource.data.status in ['accepted', 'rejected', 'ended', 'missed']))
        );
      allow delete: if false;

      match /callerCandidates/{candidateId} {
        function callParticipant() {
          let call = get(/databases/$(database)/documents/callSessions/$(callId)).data;
          return signedIn() && (request.auth.uid == call.callerUid || request.auth.uid == call.calleeUid);
        }
        allow read: if callParticipant();
        allow create: if signedIn()
          && request.auth.uid == get(/databases/$(database)/documents/callSessions/$(callId)).data.callerUid
          && request.resource.data.keys().hasOnly(['sdpMid', 'sdpMLineIndex', 'candidate', 'createdAt'])
          && request.resource.data.candidate is string;
        allow update, delete: if false;
      }
      match /calleeCandidates/{candidateId} {
        function callParticipant() {
          let call = get(/databases/$(database)/documents/callSessions/$(callId)).data;
          return signedIn() && (request.auth.uid == call.callerUid || request.auth.uid == call.calleeUid);
        }
        allow read: if callParticipant();
        allow create: if signedIn()
          && request.auth.uid == get(/databases/$(database)/documents/callSessions/$(callId)).data.calleeUid
          && request.resource.data.keys().hasOnly(['sdpMid', 'sdpMLineIndex', 'candidate', 'createdAt'])
          && request.resource.data.candidate is string;
        allow update, delete: if false;
      }
    }

  }
}
);
    }

    function areAcceptedFriends(uidA, uidB) {
      return signedIn()
        && uidA is string && uidB is string && uidA != uidB
        && (
          exists(/databases/$(database)/documents/friends/$(uidA)/list/$(uidB))
          || exists(/databases/$(database)/documents/friends/$(uidB)/list/$(uidA))
        )
        && (
          (exists(/databases/$(database)/documents/friendRequests/$(uidA + '_' + uidB))
            && get(/databases/$(database)/documents/friendRequests/$(uidA + '_' + uidB)).data.status == 'accepted')
          || (exists(/databases/$(database)/documents/friendRequests/$(uidB + '_' + uidA))
            && get(/databases/$(database)/documents/friendRequests/$(uidB + '_' + uidA)).data.status == 'accepted')
        );
    }

    function canStartChat(uidA, uidB) {
      return areAcceptedFriends(uidA, uidB)
        || (exists(/databases/$(database)/documents/publicProfiles/$(uidA))
          && get(/databases/$(database)/documents/publicProfiles/$(uidA)).data.profileVisibility == 'public')
        || (exists(/databases/$(database)/documents/publicProfiles/$(uidB))
          && get(/databases/$(database)/documents/publicProfiles/$(uidB)).data.profileVisibility == 'public');
    }

    function isAcceptedFriend(ownerUid) {
      return signedIn()
        && exists(/databases/$(database)/documents/friends/$(ownerUid)/list/$(request.auth.uid))
        && (
          (exists(/databases/$(database)/documents/friendRequests/$(ownerUid + '_' + request.auth.uid))
            && get(/databases/$(database)/documents/friendRequests/$(ownerUid + '_' + request.auth.uid)).data.status == 'accepted')
          || (exists(/databases/$(database)/documents/friendRequests/$(request.auth.uid + '_' + ownerUid))
            && get(/databases/$(database)/documents/friendRequests/$(request.auth.uid + '_' + ownerUid)).data.status == 'accepted')
        );
    }

    function profileIsPublic(ownerUid) {
      return exists(/databases/$(database)/documents/publicProfiles/$(ownerUid))
        && get(/databases/$(database)/documents/publicProfiles/$(ownerUid)).data.profileVisibility == 'public';
    }

    function canReadPost(post) {
      return signedIn() && (
        post.uid == request.auth.uid
        || (profileIsPublic(post.uid) && post.get('audience', 'public') == 'public')
        || (isAcceptedFriend(post.uid) && post.get('audience', 'public') in ['public', 'friends'])
      );
    }

    function canReadStory(story) {
      return signedIn() && (
        story.uid == request.auth.uid
        || profileIsPublic(story.uid)
        || isAcceptedFriend(story.uid)
      );
    }

    // Private account/profile data: only the account owner can access it.
    match /users/{userId} {
      // Private account/profile data: clients may edit only app-owned profile fields.
      // Server migration markers and other server-managed fields must never be client-writable.
      function allowedUserFields() {
        return [
          'uid', 'email', 'phoneNumber', 'createdAt', 'updatedAt',
          'dateOfBirth', 'gender', 'hobby', 'school', 'favoritePlace',
          'hometown', 'currentCity', 'work', 'education',
          'relationshipStatus', 'interests', 'photoUrl', 'coverPhotoUrl',
          'photoOriginalUrl', 'coverPhotoOriginalUrl',
          'photoOriginalPath', 'coverPhotoOriginalPath'
        ];
      }
      allow read: if owns(userId);
      allow create: if owns(userId)
        && request.resource.data.uid == userId
        && request.resource.data.keys().hasOnly(allowedUserFields());
      allow update: if owns(userId)
        && resource.data.uid == userId
        && request.resource.data.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'email', 'phoneNumber', 'updatedAt', 'dateOfBirth', 'gender',
          'hobby', 'school', 'favoritePlace', 'hometown', 'currentCity',
          'work', 'education', 'relationshipStatus', 'interests',
          'photoUrl', 'coverPhotoUrl', 'photoOriginalUrl',
          'coverPhotoOriginalUrl', 'photoOriginalPath', 'coverPhotoOriginalPath'
        ])
        && request.resource.data.keys().hasOnly(allowedUserFields());
      allow delete: if owns(userId);

      // Each signed-in user can manage only their own device push tokens.
      // Cloud Functions Admin SDK reads these tokens server-side.
      match /savedPosts/{postId} {
        allow read, delete: if owns(userId);
        allow create, update: if owns(userId)
          && request.resource.data.postId == postId
          && request.resource.data.ownerUid is string
          && request.resource.data.keys().hasOnly(['postId', 'ownerUid', 'savedAt']);
      }

      match /fcmTokens/{tokenId} {
        allow read: if owns(userId);
        allow create, update: if owns(userId)
          && request.resource.data.token == tokenId
          && request.resource.data.platform == 'android'
          && request.resource.data.keys().hasOnly(['token', 'platform', 'updatedAt']);
        allow delete: if owns(userId);
      }
    }

    // Public directory contains only fields safe to show to signed-in users.
    // Never put email, phone, date of birth, gender, or other private details here.
    match /publicProfiles/{userId} {
      function isAcceptedFriend() {
        return signedIn()
          && exists(/databases/$(database)/documents/friends/$(userId)/list/$(request.auth.uid))
          && (
            (exists(/databases/$(database)/documents/friendRequests/$(userId + '_' + request.auth.uid))
              && get(/databases/$(database)/documents/friendRequests/$(userId + '_' + request.auth.uid)).data.status == 'accepted')
            || (exists(/databases/$(database)/documents/friendRequests/$(request.auth.uid + '_' + userId))
              && get(/databases/$(database)/documents/friendRequests/$(request.auth.uid + '_' + userId)).data.status == 'accepted')
          );
      }
      // Missing visibility is denied by default; legacy profiles must be explicitly marked public.
      allow read: if signedIn() && (
        owns(userId)
        || isAcceptedFriend()
        || resource.data.profileVisibility == "public"
      );
      allow create: if owns(userId)
        && request.resource.data.keys().hasOnly([
          'uid', 'displayName', 'username', 'photoUrl', 'coverPhotoUrl', 'photoOriginalUrl', 'coverPhotoOriginalUrl', 'photoOriginalPath', 'coverPhotoOriginalPath', 'bio', 'hobby', 'school', 'favoritePlace', 'hometown', 'currentCity', 'work', 'education', 'relationshipStatus', 'interests', 'profileVisibility', 'updatedAt', 'createdAt'
        ])
        && request.resource.data.uid == userId;
      allow update: if owns(userId)
        && request.resource.data.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'uid', 'displayName', 'username', 'photoUrl', 'coverPhotoUrl', 'photoOriginalUrl', 'coverPhotoOriginalUrl', 'photoOriginalPath', 'coverPhotoOriginalPath', 'bio', 'hobby', 'school', 'favoritePlace', 'hometown', 'currentCity', 'work', 'education', 'relationshipStatus', 'interests', 'profileVisibility', 'isOnline', 'lastSeen', 'updatedAt'
        ])
        // Permit deletion of legacy presence fields only; never permit them to remain.
        && !request.resource.data.keys().hasAny(['isOnline', 'lastSeen']);
      allow delete: if owns(userId);
    }

    // Minimal discoverability card for every account, including private profiles.
    // Contains only name, username, avatar, cover and visibility; no bio or personal details.
    match /profileDirectory/{userId} {
      // Directory metadata remains discoverable, but private-profile bearer
      // photo URLs must never be stored in this broadly readable document.
      allow read: if signedIn();
      allow create: if owns(userId)
        && request.resource.data.uid == userId
        && request.resource.data.keys().hasOnly([
          'uid', 'displayName', 'username', 'photoUrl', 'coverPhotoUrl',
          'profileVisibility', 'updatedAt'
        ])
        && (request.resource.data.profileVisibility == 'public'
          || !request.resource.data.keys().hasAny(['photoUrl', 'coverPhotoUrl']));
      allow update: if owns(userId)
        && resource.data.uid == userId
        && request.resource.data.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'uid', 'displayName', 'username', 'photoUrl', 'coverPhotoUrl',
          'profileVisibility', 'updatedAt'
        ])
        && (request.resource.data.profileVisibility == 'public'
          || !request.resource.data.keys().hasAny(['photoUrl', 'coverPhotoUrl']));
      allow delete: if owns(userId);
    }

    // Presence is isolated from the signed-in-readable profile directory.
    // Only the owner and accepted friends can read a user's presence document.
    match /profilePresence/{userId} {
      function isAcceptedFriend() {
        return signedIn()
          && exists(/databases/$(database)/documents/friends/$(userId)/list/$(request.auth.uid))
          && (
            (exists(/databases/$(database)/documents/friendRequests/$(userId + '_' + request.auth.uid))
              && get(/databases/$(database)/documents/friendRequests/$(userId + '_' + request.auth.uid)).data.status == 'accepted')
            || (exists(/databases/$(database)/documents/friendRequests/$(request.auth.uid + '_' + userId))
              && get(/databases/$(database)/documents/friendRequests/$(request.auth.uid + '_' + userId)).data.status == 'accepted')
          );
      }
      allow get: if owns(userId) || isAcceptedFriend();
      allow list: if false;
      allow create, update: if owns(userId)
        && request.resource.data.uid == userId
        && request.resource.data.keys().hasOnly(['uid', 'isOnline', 'lastSeen', 'updatedAt']);
      allow delete: if owns(userId);
    }

    // Username reservations: one document per normalized username.
    // A user can only reserve a name for their own account.
    match /usernameClaims/{username} {
      // The app checks a single username claim; do not allow listing all claims.
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.username == username
        && username.matches('^[a-z0-9_.]{4,20}$')
        && request.resource.data.keys().hasOnly(['uid', 'username', 'createdAt']);
      allow update: if owns(resource.data.uid)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.username == username
        && request.resource.data.keys().hasOnly(['uid', 'username', 'createdAt']);
      allow delete: if owns(resource.data.uid);
    }

    match /phoneAuthCredentials/{credentialId} {
      allow read, write: if false;
    }

    // Story media is visible only to its owner, accepted friends, or public-profile viewers.
    match /stories/{storyId} {
      allow read: if canReadStory(resource.data) && resource.data.expiresAt is timestamp && resource.data.expiresAt > request.time;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          'uid', 'authorName', 'mediaUrl', 'mediaType', 'storagePath', 'createdAt', 'expiresAt'
        ])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.authorName is string
        && request.resource.data.authorName.size() > 0
        && request.resource.data.authorName.size() <= 80
        && request.resource.data.mediaUrl is string
        && request.resource.data.mediaUrl.size() <= 4096
        && request.resource.data.mediaType in ['image', 'video']
        && request.resource.data.createdAt == request.time
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt > request.time
        && request.resource.data.expiresAt <= request.time + duration.value(24, 'h') + duration.value(5, 'm')
        && (!('storagePath' in request.resource.data)
          || (request.resource.data.storagePath is string
            && (request.resource.data.storagePath == ''
              || request.resource.data.storagePath.matches('^stories/' + request.auth.uid + '/[A-Za-z0-9_.-]{1,180}')
              || request.resource.data.storagePath.matches('^reels/' + request.auth.uid + '/[A-Za-z0-9_.-]{1,180}'))))
        && (request.resource.data.mediaUrl.size() > 0
          || (request.resource.data.storagePath is string && request.resource.data.storagePath.size() > 0));
      allow update: if false;
      allow delete: if owns(resource.data.uid);
    }

    match /posts/{postId} {
      // Enforce each post's audience and the author's profile visibility.
      allow read: if canReadPost(resource.data);
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.authorName is string
        && request.resource.data.authorName.size() > 0
        && request.resource.data.authorName.size() <= 80
        && (!('audience' in request.resource.data)
          || request.resource.data.audience in ['public', 'friends', 'private'])
        && (!('text' in request.resource.data)
          || (request.resource.data.text is string && request.resource.data.text.size() <= 5000))
        && (!('mediaUrl' in request.resource.data)
          || (request.resource.data.mediaUrl is string && request.resource.data.mediaUrl.size() <= 4096))
        && (!('storagePath' in request.resource.data)
          || (request.resource.data.storagePath is string
            && (request.resource.data.storagePath == ''
              || request.resource.data.storagePath.matches('^post_photos/' + request.auth.uid + '/[A-Za-z0-9_.-]{1,180}')
              || request.resource.data.storagePath.matches('^reels/' + request.auth.uid + '/[A-Za-z0-9_.-]{1,180}'))))
        && ((('text' in request.resource.data) && request.resource.data.text.size() > 0)
          || (('mediaUrl' in request.resource.data) && request.resource.data.mediaUrl.size() > 0)
          || (('storagePath' in request.resource.data) && request.resource.data.storagePath is string && request.resource.data.storagePath.size() > 0));

      // A post's owner identity and audience cannot be changed by editing it.
      allow update: if owns(resource.data.uid)
        && request.resource.data.uid == resource.data.uid
        && (!('audience' in request.resource.data)
          || request.resource.data.audience in ['public', 'friends', 'private'])
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'authorName', 'text', 'mediaUrl', 'mediaType', 'postType', 'audience',
          'location', 'taggedUsers', 'overlayText', 'sticker', 'effect',
          'originalAudioMuted', 'updatedAt'
        ]);
      allow delete: if owns(resource.data.uid);

      match /likes/{likerId} {
        // Parent post access is required before reading or changing reactions.
        allow read: if exists(/databases/$(database)/documents/posts/$(postId))
          && canReadPost(get(/databases/$(database)/documents/posts/$(postId)).data);
        allow create: if owns(likerId)
          && exists(/databases/$(database)/documents/posts/$(postId))
          && canReadPost(get(/databases/$(database)/documents/posts/$(postId)).data)
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.reaction in ['👍', '❤️', '😂', '😢', '😡'];
        allow update: if owns(likerId)
          && exists(/databases/$(database)/documents/posts/$(postId))
          && canReadPost(get(/databases/$(database)/documents/posts/$(postId)).data)
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.reaction in ['👍', '❤️', '😂', '😢', '😡']
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reaction', 'createdAt']);
        allow delete: if owns(likerId)
        && exists(/databases/$(database)/documents/posts/$(postId))
        && canReadPost(get(/databases/$(database)/documents/posts/$(postId)).data);
      }
      match /comments/{commentId} {
        allow read: if exists(/databases/$(database)/documents/posts/$(postId))
          && canReadPost(get(/databases/$(database)/documents/posts/$(postId)).data);
        allow create: if signedIn()
          && exists(/databases/$(database)/documents/posts/$(postId))
          && canReadPost(get(/databases/$(database)/documents/posts/$(postId)).data)
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 1000
          && request.resource.data.parentId == postId;
        allow update: if signedIn()
          && exists(/databases/$(database)/documents/posts/$(postId))
          && canReadPost(get(/databases/$(database)/documents/posts/$(postId)).data)
          && resource.data.uid == request.auth.uid
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.parentId == resource.data.parentId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'updatedAt']);
        allow delete: if signedIn()
          && exists(/databases/$(database)/documents/posts/$(postId))
          && canReadPost(get(/databases/$(database)/documents/posts/$(postId)).data)
          && resource.data.uid == request.auth.uid;
      }
    }

    match /postReports/{reportId} {
      allow create: if signedIn()
        && request.resource.data.reporterUid == request.auth.uid
        && request.resource.data.postId is string
        && request.resource.data.postOwnerUid is string
        && request.resource.data.keys().hasOnly(['postId', 'postOwnerUid', 'reporterUid', 'createdAt']);
      allow read, update, delete: if false;
    }

    match /friendRequests/{requestId} {
      // The profile screen listens to both deterministic request IDs. One
      // direction is normally absent, so authorize that exact pair lookup too;
      // otherwise reading a non-existent request is denied before Unfriend opens.
      allow read: if signedIn()
        && (
          requestId.matches('^' + request.auth.uid + '_[^_]+$')
          || requestId.matches('^[^_]+_' + request.auth.uid + '$')
          || resource.data.fromUid == request.auth.uid
          || resource.data.toUid == request.auth.uid
        );
      allow create: if signedIn()
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.toUid is string
        && request.resource.data.toUid != request.auth.uid
        && request.resource.data.status == 'pending';
      allow update: if signedIn() && (
        // Recipient can accept or reject a pending request.
        (resource.data.toUid == request.auth.uid
          && resource.data.status == 'pending'
          && request.resource.data.fromUid == resource.data.fromUid
          && request.resource.data.toUid == resource.data.toUid
          && request.resource.data.status in ['accepted', 'rejected']
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']))
        // Either participant can revoke an accepted friendship.
        || ((resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid)
          && resource.data.status == 'accepted'
          && request.resource.data.fromUid == resource.data.fromUid
          && request.resource.data.toUid == resource.data.toUid
          && request.resource.data.status == 'rejected'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']))
        // Original sender can resend a rejected request.
        || (resource.data.fromUid == request.auth.uid
          && resource.data.status == 'rejected'
          && request.resource.data.fromUid == resource.data.fromUid
          && request.resource.data.toUid == resource.data.toUid
          && request.resource.data.status == 'pending'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']))
      );
      allow delete: if signedIn()
        && (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid);
    }

    match /friends/{userId}/list/{friendId} {
      function hasAcceptedRequest() {
        return (exists(/databases/$(database)/documents/friendRequests/$(userId + '_' + friendId))
          && getAfter(/databases/$(database)/documents/friendRequests/$(userId + '_' + friendId)).data.status == 'accepted')
          || (exists(/databases/$(database)/documents/friendRequests/$(friendId + '_' + userId))
          && getAfter(/databases/$(database)/documents/friendRequests/$(friendId + '_' + userId)).data.status == 'accepted');
      }
      allow read: if owns(userId);
      allow create, update: if signedIn()
        && (request.auth.uid == userId || request.auth.uid == friendId)
        && hasAcceptedRequest();
      // Either participant can remove the friendship from both users' lists.
      allow delete: if signedIn()
        && (owns(userId) || request.auth.uid == friendId);
    }

    match /chats/{chatId} {
      allow read: if signedIn() && request.auth.uid in resource.data.participantIds;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          'participantIds', 'updatedAt', 'lastMessage', 'lastMessageAt', 'lastSenderUid',
          'autoDeleteSeconds', 'autoDeleteLabel',
          'lastReadAt_' + request.auth.uid, 'unreadCount_' + request.auth.uid
        ])
        && request.resource.data.participantIds is list
        && request.resource.data.participantIds.size() == 2
        && request.resource.data.participantIds[0] != request.resource.data.participantIds[1]
        && request.auth.uid in request.resource.data.participantIds
        && canStartChat(request.resource.data.participantIds[0], request.resource.data.participantIds[1]);
      allow update: if signedIn()
        && request.auth.uid in resource.data.participantIds
        && request.resource.data.participantIds == resource.data.participantIds
        && (!('lastSenderUid' in request.resource.data) || request.resource.data.lastSenderUid == request.auth.uid)
        && (!('lastMessage' in request.resource.data) || (request.resource.data.lastMessage is string && request.resource.data.lastMessage.size() <= 4000))
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'updatedAt', 'lastMessage', 'lastMessageAt', 'lastSenderUid',
          'autoDeleteSeconds', 'autoDeleteLabel',
          'lastReadAt_' + request.auth.uid,
          'unreadCount_' + request.auth.uid
        ])
        && (!('autoDeleteSeconds' in request.resource.data)
          || request.resource.data.autoDeleteSeconds in [0, 86400, 604800, 1296000, 2592000]);
      match /messages/{messageId} {
        function isChatParticipant() {
          return signedIn()
            && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participantIds;
        }
        allow read: if isChatParticipant();
        allow create: if isChatParticipant()
          && request.resource.data.keys().hasOnly(['uid', 'text', 'createdAt', 'expireAt'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 4000
          && (!('expireAt' in request.resource.data)
            || (request.resource.data.expireAt is timestamp
              && request.resource.data.expireAt > request.time
              && request.resource.data.expireAt <= request.time + duration.value(30, 'd')));
        allow update: if false;
        allow delete: if isChatParticipant() && resource.data.uid == request.auth.uid;
      }
    }
    // WebRTC call signalling. Firestore stores call metadata, SDP and ICE
    // candidates; audio/video media is not stored in Firestore.
    match /callSessions/{callId} {
      function isParticipant() {
        return signedIn()
          && (request.auth.uid == resource.data.callerUid
            || request.auth.uid == resource.data.calleeUid);
      }
      function isCaller() {
        return signedIn() && request.auth.uid == resource.data.callerUid;
      }
      function isCallee() {
        return signedIn() && request.auth.uid == resource.data.calleeUid;
      }
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          'callerUid', 'calleeUid', 'status', 'callType', 'offer', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.callerUid == request.auth.uid
        && request.resource.data.calleeUid is string
        && request.resource.data.calleeUid != request.auth.uid
        && areAcceptedFriends(request.auth.uid, request.resource.data.calleeUid)
        && request.resource.data.status == 'ringing'
        && request.resource.data.callType in ['audio', 'video'];
      allow read: if isParticipant();
      allow update: if isParticipant()
        && request.resource.data.callerUid == resource.data.callerUid
        && request.resource.data.calleeUid == resource.data.calleeUid
        && request.resource.data.callType == resource.data.callType
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'offer', 'answer', 'updatedAt', 'endedAt', 'acceptedAt'
        ])
        && (
          (isCaller()
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['offer', 'status', 'updatedAt', 'endedAt'])
            && (request.resource.data.status == resource.data.status
              || request.resource.data.status == 'ended'))
          ||
          (isCallee()
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['answer', 'status', 'updatedAt', 'acceptedAt', 'endedAt'])
            && (request.resource.data.status == resource.data.status
              || request.resource.data.status in ['accepted', 'rejected', 'ended', 'missed']))
        );
      allow delete: if false;

      match /callerCandidates/{candidateId} {
        function callParticipant() {
          let call = get(/databases/$(database)/documents/callSessions/$(callId)).data;
          return signedIn() && (request.auth.uid == call.callerUid || request.auth.uid == call.calleeUid);
        }
        allow read: if callParticipant();
        allow create: if signedIn()
          && request.auth.uid == get(/databases/$(database)/documents/callSessions/$(callId)).data.callerUid
          && request.resource.data.keys().hasOnly(['sdpMid', 'sdpMLineIndex', 'candidate', 'createdAt'])
          && request.resource.data.candidate is string;
        allow update, delete: if false;
      }
      match /calleeCandidates/{candidateId} {
        function callParticipant() {
          let call = get(/databases/$(database)/documents/callSessions/$(callId)).data;
          return signedIn() && (request.auth.uid == call.callerUid || request.auth.uid == call.calleeUid);
        }
        allow read: if callParticipant();
        allow create: if signedIn()
          && request.auth.uid == get(/databases/$(database)/documents/callSessions/$(callId)).data.calleeUid
          && request.resource.data.keys().hasOnly(['sdpMid', 'sdpMLineIndex', 'candidate', 'createdAt'])
          && request.resource.data.candidate is string;
        allow update, delete: if false;
      }
    }

  }
}
);
    }

    function areAcceptedFriends(uidA, uidB) {
      return signedIn()
        && uidA is string && uidB is string && uidA != uidB
        && (
          exists(/databases/$(database)/documents/friends/$(uidA)/list/$(uidB))
          || exists(/databases/$(database)/documents/friends/$(uidB)/list/$(uidA))
        )
        && (
          (exists(/databases/$(database)/documents/friendRequests/$(uidA + '_' + uidB))
            && get(/databases/$(database)/documents/friendRequests/$(uidA + '_' + uidB)).data.status == 'accepted')
          || (exists(/databases/$(database)/documents/friendRequests/$(uidB + '_' + uidA))
            && get(/databases/$(database)/documents/friendRequests/$(uidB + '_' + uidA)).data.status == 'accepted')
        );
    }

    function canStartChat(uidA, uidB) {
      return areAcceptedFriends(uidA, uidB)
        || (exists(/databases/$(database)/documents/publicProfiles/$(uidA))
          && get(/databases/$(database)/documents/publicProfiles/$(uidA)).data.profileVisibility == 'public')
        || (exists(/databases/$(database)/documents/publicProfiles/$(uidB))
          && get(/databases/$(database)/documents/publicProfiles/$(uidB)).data.profileVisibility == 'public');
    }

    function isAcceptedFriend(ownerUid) {
      return signedIn()
        && exists(/databases/$(database)/documents/friends/$(ownerUid)/list/$(request.auth.uid))
        && (
          (exists(/databases/$(database)/documents/friendRequests/$(ownerUid + '_' + request.auth.uid))
            && get(/databases/$(database)/documents/friendRequests/$(ownerUid + '_' + request.auth.uid)).data.status == 'accepted')
          || (exists(/databases/$(database)/documents/friendRequests/$(request.auth.uid + '_' + ownerUid))
            && get(/databases/$(database)/documents/friendRequests/$(request.auth.uid + '_' + ownerUid)).data.status == 'accepted')
        );
    }

    function profileIsPublic(ownerUid) {
      return exists(/databases/$(database)/documents/publicProfiles/$(ownerUid))
        && get(/databases/$(database)/documents/publicProfiles/$(ownerUid)).data.profileVisibility == 'public';
    }

    function canReadPost(post) {
      return signedIn() && (
        post.uid == request.auth.uid
        || (profileIsPublic(post.uid) && post.get('audience', 'public') == 'public')
        || (isAcceptedFriend(post.uid) && post.get('audience', 'public') in ['public', 'friends'])
      );
    }

    function canReadStory(story) {
      return signedIn() && (
        story.uid == request.auth.uid
        || profileIsPublic(story.uid)
        || isAcceptedFriend(story.uid)
      );
    }

    // Private account/profile data: only the account owner can access it.
    match /users/{userId} {
      // Private account/profile data: clients may edit only app-owned profile fields.
      // Server migration markers and other server-managed fields must never be client-writable.
      function allowedUserFields() {
        return [
          'uid', 'email', 'phoneNumber', 'createdAt', 'updatedAt',
          'dateOfBirth', 'gender', 'hobby', 'school', 'favoritePlace',
          'hometown', 'currentCity', 'work', 'education',
          'relationshipStatus', 'interests', 'photoUrl', 'coverPhotoUrl',
          'photoOriginalUrl', 'coverPhotoOriginalUrl',
          'photoOriginalPath', 'coverPhotoOriginalPath'
        ];
      }
      allow read: if owns(userId);
      allow create: if owns(userId)
        && request.resource.data.uid == userId
        && request.resource.data.keys().hasOnly(allowedUserFields());
      allow update: if owns(userId)
        && resource.data.uid == userId
        && request.resource.data.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'email', 'phoneNumber', 'updatedAt', 'dateOfBirth', 'gender',
          'hobby', 'school', 'favoritePlace', 'hometown', 'currentCity',
          'work', 'education', 'relationshipStatus', 'interests',
          'photoUrl', 'coverPhotoUrl', 'photoOriginalUrl',
          'coverPhotoOriginalUrl', 'photoOriginalPath', 'coverPhotoOriginalPath'
        ])
        && request.resource.data.keys().hasOnly(allowedUserFields());
      allow delete: if owns(userId);

      // Each signed-in user can manage only their own device push tokens.
      // Cloud Functions Admin SDK reads these tokens server-side.
      match /savedPosts/{postId} {
        allow read, delete: if owns(userId);
        allow create, update: if owns(userId)
          && request.resource.data.postId == postId
          && request.resource.data.ownerUid is string
          && request.resource.data.keys().hasOnly(['postId', 'ownerUid', 'savedAt']);
      }

      match /fcmTokens/{tokenId} {
        allow read: if owns(userId);
        allow create, update: if owns(userId)
          && request.resource.data.token == tokenId
          && request.resource.data.platform == 'android'
          && request.resource.data.keys().hasOnly(['token', 'platform', 'updatedAt']);
        allow delete: if owns(userId);
      }
    }

    // Public directory contains only fields safe to show to signed-in users.
    // Never put email, phone, date of birth, gender, or other private details here.
    match /publicProfiles/{userId} {
      function isAcceptedFriend() {
        return signedIn()
          && exists(/databases/$(database)/documents/friends/$(userId)/list/$(request.auth.uid))
          && (
            (exists(/databases/$(database)/documents/friendRequests/$(userId + '_' + request.auth.uid))
              && get(/databases/$(database)/documents/friendRequests/$(userId + '_' + request.auth.uid)).data.status == 'accepted')
            || (exists(/databases/$(database)/documents/friendRequests/$(request.auth.uid + '_' + userId))
              && get(/databases/$(database)/documents/friendRequests/$(request.auth.uid + '_' + userId)).data.status == 'accepted')
          );
      }
      // Missing visibility is denied by default; legacy profiles must be explicitly marked public.
      allow read: if signedIn() && (
        owns(userId)
        || isAcceptedFriend()
        || resource.data.profileVisibility == "public"
      );
      allow create: if owns(userId)
        && request.resource.data.keys().hasOnly([
          'uid', 'displayName', 'username', 'photoUrl', 'coverPhotoUrl', 'photoOriginalUrl', 'coverPhotoOriginalUrl', 'photoOriginalPath', 'coverPhotoOriginalPath', 'bio', 'hobby', 'school', 'favoritePlace', 'hometown', 'currentCity', 'work', 'education', 'relationshipStatus', 'interests', 'profileVisibility', 'updatedAt', 'createdAt'
        ])
        && request.resource.data.uid == userId;
      allow update: if owns(userId)
        && request.resource.data.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'uid', 'displayName', 'username', 'photoUrl', 'coverPhotoUrl', 'photoOriginalUrl', 'coverPhotoOriginalUrl', 'photoOriginalPath', 'coverPhotoOriginalPath', 'bio', 'hobby', 'school', 'favoritePlace', 'hometown', 'currentCity', 'work', 'education', 'relationshipStatus', 'interests', 'profileVisibility', 'isOnline', 'lastSeen', 'updatedAt'
        ])
        // Permit deletion of legacy presence fields only; never permit them to remain.
        && !request.resource.data.keys().hasAny(['isOnline', 'lastSeen']);
      allow delete: if owns(userId);
    }

    // Minimal discoverability card for every account, including private profiles.
    // Contains only name, username, avatar, cover and visibility; no bio or personal details.
    match /profileDirectory/{userId} {
      // Directory metadata remains discoverable, but private-profile bearer
      // photo URLs must never be stored in this broadly readable document.
      allow read: if signedIn();
      allow create: if owns(userId)
        && request.resource.data.uid == userId
        && request.resource.data.keys().hasOnly([
          'uid', 'displayName', 'username', 'photoUrl', 'coverPhotoUrl',
          'profileVisibility', 'updatedAt'
        ])
        && (request.resource.data.profileVisibility == 'public'
          || !request.resource.data.keys().hasAny(['photoUrl', 'coverPhotoUrl']));
      allow update: if owns(userId)
        && resource.data.uid == userId
        && request.resource.data.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'uid', 'displayName', 'username', 'photoUrl', 'coverPhotoUrl',
          'profileVisibility', 'updatedAt'
        ])
        && (request.resource.data.profileVisibility == 'public'
          || !request.resource.data.keys().hasAny(['photoUrl', 'coverPhotoUrl']));
      allow delete: if owns(userId);
    }

    // Presence is isolated from the signed-in-readable profile directory.
    // Only the owner and accepted friends can read a user's presence document.
    match /profilePresence/{userId} {
      function isAcceptedFriend() {
        return signedIn()
          && exists(/databases/$(database)/documents/friends/$(userId)/list/$(request.auth.uid))
          && (
            (exists(/databases/$(database)/documents/friendRequests/$(userId + '_' + request.auth.uid))
              && get(/databases/$(database)/documents/friendRequests/$(userId + '_' + request.auth.uid)).data.status == 'accepted')
            || (exists(/databases/$(database)/documents/friendRequests/$(request.auth.uid + '_' + userId))
              && get(/databases/$(database)/documents/friendRequests/$(request.auth.uid + '_' + userId)).data.status == 'accepted')
          );
      }
      allow get: if owns(userId) || isAcceptedFriend();
      allow list: if false;
      allow create, update: if owns(userId)
        && request.resource.data.uid == userId
        && request.resource.data.keys().hasOnly(['uid', 'isOnline', 'lastSeen', 'updatedAt']);
      allow delete: if owns(userId);
    }

    // Username reservations: one document per normalized username.
    // A user can only reserve a name for their own account.
    match /usernameClaims/{username} {
      // The app checks a single username claim; do not allow listing all claims.
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.username == username
        && username.matches('^[a-z0-9_.]{4,20}$')
        && request.resource.data.keys().hasOnly(['uid', 'username', 'createdAt']);
      allow update: if owns(resource.data.uid)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.username == username
        && request.resource.data.keys().hasOnly(['uid', 'username', 'createdAt']);
      allow delete: if owns(resource.data.uid);
    }

    match /phoneAuthCredentials/{credentialId} {
      allow read, write: if false;
    }

    // Story media is visible only to its owner, accepted friends, or public-profile viewers.
    match /stories/{storyId} {
      allow read: if canReadStory(resource.data) && resource.data.expiresAt is timestamp && resource.data.expiresAt > request.time;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          'uid', 'authorName', 'mediaUrl', 'mediaType', 'storagePath', 'createdAt', 'expiresAt'
        ])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.authorName is string
        && request.resource.data.authorName.size() > 0
        && request.resource.data.authorName.size() <= 80
        && request.resource.data.mediaUrl is string
        && request.resource.data.mediaUrl.size() <= 4096
        && request.resource.data.mediaType in ['image', 'video']
        && request.resource.data.createdAt == request.time
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt > request.time
        && request.resource.data.expiresAt <= request.time + duration.value(24, 'h') + duration.value(5, 'm')
        && (!('storagePath' in request.resource.data)
          || request.resource.data.storagePath == ''
          || isOwnedMediaPath(request.resource.data.storagePath, 'stories')
          || isOwnedMediaPath(request.resource.data.storagePath, 'reels'))
        && (request.resource.data.mediaUrl.size() > 0
          || (request.resource.data.storagePath is string && request.resource.data.storagePath.size() > 0));
      allow update: if false;
      allow delete: if owns(resource.data.uid);
    }

    match /posts/{postId} {
      // Enforce each post's audience and the author's profile visibility.
      allow read: if canReadPost(resource.data);
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.authorName is string
        && request.resource.data.authorName.size() > 0
        && request.resource.data.authorName.size() <= 80
        && (!('audience' in request.resource.data)
          || request.resource.data.audience in ['public', 'friends', 'private'])
        && (!('text' in request.resource.data)
          || (request.resource.data.text is string && request.resource.data.text.size() <= 5000))
        && (!('mediaUrl' in request.resource.data)
          || (request.resource.data.mediaUrl is string && request.resource.data.mediaUrl.size() <= 4096))
        && (!('storagePath' in request.resource.data)
          || request.resource.data.storagePath == ''
          || isOwnedMediaPath(request.resource.data.storagePath, 'post_photos')
          || isOwnedMediaPath(request.resource.data.storagePath, 'reels'))
        && ((('text' in request.resource.data) && request.resource.data.text.size() > 0)
          || (('mediaUrl' in request.resource.data) && request.resource.data.mediaUrl.size() > 0)
          || (('storagePath' in request.resource.data) && request.resource.data.storagePath is string && request.resource.data.storagePath.size() > 0));

      // A post's owner identity and audience cannot be changed by editing it.
      allow update: if owns(resource.data.uid)
        && request.resource.data.uid == resource.data.uid
        && (!('audience' in request.resource.data)
          || request.resource.data.audience in ['public', 'friends', 'private'])
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'authorName', 'text', 'mediaUrl', 'mediaType', 'postType', 'audience',
          'location', 'taggedUsers', 'overlayText', 'sticker', 'effect',
          'originalAudioMuted', 'updatedAt'
        ]);
      allow delete: if owns(resource.data.uid);

      match /likes/{likerId} {
        // Parent post access is required before reading or changing reactions.
        allow read: if exists(/databases/$(database)/documents/posts/$(postId))
          && canReadPost(get(/databases/$(database)/documents/posts/$(postId)).data);
        allow create: if owns(likerId)
          && exists(/databases/$(database)/documents/posts/$(postId))
          && canReadPost(get(/databases/$(database)/documents/posts/$(postId)).data)
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.reaction in ['👍', '❤️', '😂', '😢', '😡'];
        allow update: if owns(likerId)
          && exists(/databases/$(database)/documents/posts/$(postId))
          && canReadPost(get(/databases/$(database)/documents/posts/$(postId)).data)
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.reaction in ['👍', '❤️', '😂', '😢', '😡']
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reaction', 'createdAt']);
        allow delete: if owns(likerId)
        && exists(/databases/$(database)/documents/posts/$(postId))
        && canReadPost(get(/databases/$(database)/documents/posts/$(postId)).data);
      }
      match /comments/{commentId} {
        allow read: if exists(/databases/$(database)/documents/posts/$(postId))
          && canReadPost(get(/databases/$(database)/documents/posts/$(postId)).data);
        allow create: if signedIn()
          && exists(/databases/$(database)/documents/posts/$(postId))
          && canReadPost(get(/databases/$(database)/documents/posts/$(postId)).data)
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 1000
          && request.resource.data.parentId == postId;
        allow update: if signedIn()
          && exists(/databases/$(database)/documents/posts/$(postId))
          && canReadPost(get(/databases/$(database)/documents/posts/$(postId)).data)
          && resource.data.uid == request.auth.uid
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.parentId == resource.data.parentId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'updatedAt']);
        allow delete: if signedIn()
          && exists(/databases/$(database)/documents/posts/$(postId))
          && canReadPost(get(/databases/$(database)/documents/posts/$(postId)).data)
          && resource.data.uid == request.auth.uid;
      }
    }

    match /postReports/{reportId} {
      allow create: if signedIn()
        && request.resource.data.reporterUid == request.auth.uid
        && request.resource.data.postId is string
        && request.resource.data.postOwnerUid is string
        && request.resource.data.keys().hasOnly(['postId', 'postOwnerUid', 'reporterUid', 'createdAt']);
      allow read, update, delete: if false;
    }

    match /friendRequests/{requestId} {
      // The profile screen listens to both deterministic request IDs. One
      // direction is normally absent, so authorize that exact pair lookup too;
      // otherwise reading a non-existent request is denied before Unfriend opens.
      allow read: if signedIn()
        && (
          requestId.matches('^' + request.auth.uid + '_[^_]+$')
          || requestId.matches('^[^_]+_' + request.auth.uid + '$')
          || resource.data.fromUid == request.auth.uid
          || resource.data.toUid == request.auth.uid
        );
      allow create: if signedIn()
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.toUid is string
        && request.resource.data.toUid != request.auth.uid
        && request.resource.data.status == 'pending';
      allow update: if signedIn() && (
        // Recipient can accept or reject a pending request.
        (resource.data.toUid == request.auth.uid
          && resource.data.status == 'pending'
          && request.resource.data.fromUid == resource.data.fromUid
          && request.resource.data.toUid == resource.data.toUid
          && request.resource.data.status in ['accepted', 'rejected']
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']))
        // Either participant can revoke an accepted friendship.
        || ((resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid)
          && resource.data.status == 'accepted'
          && request.resource.data.fromUid == resource.data.fromUid
          && request.resource.data.toUid == resource.data.toUid
          && request.resource.data.status == 'rejected'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']))
        // Original sender can resend a rejected request.
        || (resource.data.fromUid == request.auth.uid
          && resource.data.status == 'rejected'
          && request.resource.data.fromUid == resource.data.fromUid
          && request.resource.data.toUid == resource.data.toUid
          && request.resource.data.status == 'pending'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']))
      );
      allow delete: if signedIn()
        && (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid);
    }

    match /friends/{userId}/list/{friendId} {
      function hasAcceptedRequest() {
        return (exists(/databases/$(database)/documents/friendRequests/$(userId + '_' + friendId))
          && getAfter(/databases/$(database)/documents/friendRequests/$(userId + '_' + friendId)).data.status == 'accepted')
          || (exists(/databases/$(database)/documents/friendRequests/$(friendId + '_' + userId))
          && getAfter(/databases/$(database)/documents/friendRequests/$(friendId + '_' + userId)).data.status == 'accepted');
      }
      allow read: if owns(userId);
      allow create, update: if signedIn()
        && (request.auth.uid == userId || request.auth.uid == friendId)
        && hasAcceptedRequest();
      // Either participant can remove the friendship from both users' lists.
      allow delete: if signedIn()
        && (owns(userId) || request.auth.uid == friendId);
    }

    match /chats/{chatId} {
      allow read: if signedIn() && request.auth.uid in resource.data.participantIds;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          'participantIds', 'updatedAt', 'lastMessage', 'lastMessageAt', 'lastSenderUid',
          'autoDeleteSeconds', 'autoDeleteLabel',
          'lastReadAt_' + request.auth.uid, 'unreadCount_' + request.auth.uid
        ])
        && request.resource.data.participantIds is list
        && request.resource.data.participantIds.size() == 2
        && request.resource.data.participantIds[0] != request.resource.data.participantIds[1]
        && request.auth.uid in request.resource.data.participantIds
        && canStartChat(request.resource.data.participantIds[0], request.resource.data.participantIds[1]);
      allow update: if signedIn()
        && request.auth.uid in resource.data.participantIds
        && request.resource.data.participantIds == resource.data.participantIds
        && (!('lastSenderUid' in request.resource.data) || request.resource.data.lastSenderUid == request.auth.uid)
        && (!('lastMessage' in request.resource.data) || (request.resource.data.lastMessage is string && request.resource.data.lastMessage.size() <= 4000))
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'updatedAt', 'lastMessage', 'lastMessageAt', 'lastSenderUid',
          'autoDeleteSeconds', 'autoDeleteLabel',
          'lastReadAt_' + request.auth.uid,
          'unreadCount_' + request.auth.uid
        ])
        && (!('autoDeleteSeconds' in request.resource.data)
          || request.resource.data.autoDeleteSeconds in [0, 86400, 604800, 1296000, 2592000]);
      match /messages/{messageId} {
        function isChatParticipant() {
          return signedIn()
            && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participantIds;
        }
        allow read: if isChatParticipant();
        allow create: if isChatParticipant()
          && request.resource.data.keys().hasOnly(['uid', 'text', 'createdAt', 'expireAt'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 4000
          && (!('expireAt' in request.resource.data)
            || (request.resource.data.expireAt is timestamp
              && request.resource.data.expireAt > request.time
              && request.resource.data.expireAt <= request.time + duration.value(30, 'd')));
        allow update: if false;
        allow delete: if isChatParticipant() && resource.data.uid == request.auth.uid;
      }
    }
    // WebRTC call signalling. Firestore stores call metadata, SDP and ICE
    // candidates; audio/video media is not stored in Firestore.
    match /callSessions/{callId} {
      function isParticipant() {
        return signedIn()
          && (request.auth.uid == resource.data.callerUid
            || request.auth.uid == resource.data.calleeUid);
      }
      function isCaller() {
        return signedIn() && request.auth.uid == resource.data.callerUid;
      }
      function isCallee() {
        return signedIn() && request.auth.uid == resource.data.calleeUid;
      }
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          'callerUid', 'calleeUid', 'status', 'callType', 'offer', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.callerUid == request.auth.uid
        && request.resource.data.calleeUid is string
        && request.resource.data.calleeUid != request.auth.uid
        && areAcceptedFriends(request.auth.uid, request.resource.data.calleeUid)
        && request.resource.data.status == 'ringing'
        && request.resource.data.callType in ['audio', 'video'];
      allow read: if isParticipant();
      allow update: if isParticipant()
        && request.resource.data.callerUid == resource.data.callerUid
        && request.resource.data.calleeUid == resource.data.calleeUid
        && request.resource.data.callType == resource.data.callType
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'offer', 'answer', 'updatedAt', 'endedAt', 'acceptedAt'
        ])
        && (
          (isCaller()
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['offer', 'status', 'updatedAt', 'endedAt'])
            && (request.resource.data.status == resource.data.status
              || request.resource.data.status == 'ended'))
          ||
          (isCallee()
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['answer', 'status', 'updatedAt', 'acceptedAt', 'endedAt'])
            && (request.resource.data.status == resource.data.status
              || request.resource.data.status in ['accepted', 'rejected', 'ended', 'missed']))
        );
      allow delete: if false;

      match /callerCandidates/{candidateId} {
        function callParticipant() {
          let call = get(/databases/$(database)/documents/callSessions/$(callId)).data;
          return signedIn() && (request.auth.uid == call.callerUid || request.auth.uid == call.calleeUid);
        }
        allow read: if callParticipant();
        allow create: if signedIn()
          && request.auth.uid == get(/databases/$(database)/documents/callSessions/$(callId)).data.callerUid
          && request.resource.data.keys().hasOnly(['sdpMid', 'sdpMLineIndex', 'candidate', 'createdAt'])
          && request.resource.data.candidate is string;
        allow update, delete: if false;
      }
      match /calleeCandidates/{candidateId} {
        function callParticipant() {
          let call = get(/databases/$(database)/documents/callSessions/$(callId)).data;
          return signedIn() && (request.auth.uid == call.callerUid || request.auth.uid == call.calleeUid);
        }
        allow read: if callParticipant();
        allow create: if signedIn()
          && request.auth.uid == get(/databases/$(database)/documents/callSessions/$(callId)).data.calleeUid
          && request.resource.data.keys().hasOnly(['sdpMid', 'sdpMLineIndex', 'candidate', 'createdAt'])
          && request.resource.data.candidate is string;
        allow update, delete: if false;
      }
    }

  }
}
);
    }

    function areAcceptedFriends(uidA, uidB) {
      return signedIn()
        && uidA is string && uidB is string && uidA != uidB
        && (
          exists(/databases/$(database)/documents/friends/$(uidA)/list/$(uidB))
          || exists(/databases/$(database)/documents/friends/$(uidB)/list/$(uidA))
        )
        && (
          (exists(/databases/$(database)/documents/friendRequests/$(uidA + '_' + uidB))
            && get(/databases/$(database)/documents/friendRequests/$(uidA + '_' + uidB)).data.status == 'accepted')
          || (exists(/databases/$(database)/documents/friendRequests/$(uidB + '_' + uidA))
            && get(/databases/$(database)/documents/friendRequests/$(uidB + '_' + uidA)).data.status == 'accepted')
        );
    }

    function canStartChat(uidA, uidB) {
      return areAcceptedFriends(uidA, uidB)
        || (exists(/databases/$(database)/documents/publicProfiles/$(uidA))
          && get(/databases/$(database)/documents/publicProfiles/$(uidA)).data.profileVisibility == 'public')
        || (exists(/databases/$(database)/documents/publicProfiles/$(uidB))
          && get(/databases/$(database)/documents/publicProfiles/$(uidB)).data.profileVisibility == 'public');
    }

    function isAcceptedFriend(ownerUid) {
      return signedIn()
        && exists(/databases/$(database)/documents/friends/$(ownerUid)/list/$(request.auth.uid))
        && (
          (exists(/databases/$(database)/documents/friendRequests/$(ownerUid + '_' + request.auth.uid))
            && get(/databases/$(database)/documents/friendRequests/$(ownerUid + '_' + request.auth.uid)).data.status == 'accepted')
          || (exists(/databases/$(database)/documents/friendRequests/$(request.auth.uid + '_' + ownerUid))
            && get(/databases/$(database)/documents/friendRequests/$(request.auth.uid + '_' + ownerUid)).data.status == 'accepted')
        );
    }

    function profileIsPublic(ownerUid) {
      return exists(/databases/$(database)/documents/publicProfiles/$(ownerUid))
        && get(/databases/$(database)/documents/publicProfiles/$(ownerUid)).data.profileVisibility == 'public';
    }

    function canReadPost(post) {
      return signedIn() && (
        post.uid == request.auth.uid
        || (profileIsPublic(post.uid) && post.get('audience', 'public') == 'public')
        || (isAcceptedFriend(post.uid) && post.get('audience', 'public') in ['public', 'friends'])
      );
    }

    function canReadStory(story) {
      return signedIn() && (
        story.uid == request.auth.uid
        || profileIsPublic(story.uid)
        || isAcceptedFriend(story.uid)
      );
    }

    // Private account/profile data: only the account owner can access it.
    match /users/{userId} {
      // Private account/profile data: clients may edit only app-owned profile fields.
      // Server migration markers and other server-managed fields must never be client-writable.
      function allowedUserFields() {
        return [
          'uid', 'email', 'phoneNumber', 'createdAt', 'updatedAt',
          'dateOfBirth', 'gender', 'hobby', 'school', 'favoritePlace',
          'hometown', 'currentCity', 'work', 'education',
          'relationshipStatus', 'interests', 'photoUrl', 'coverPhotoUrl',
          'photoOriginalUrl', 'coverPhotoOriginalUrl',
          'photoOriginalPath', 'coverPhotoOriginalPath'
        ];
      }
      allow read: if owns(userId);
      allow create: if owns(userId)
        && request.resource.data.uid == userId
        && request.resource.data.keys().hasOnly(allowedUserFields());
      allow update: if owns(userId)
        && resource.data.uid == userId
        && request.resource.data.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'email', 'phoneNumber', 'updatedAt', 'dateOfBirth', 'gender',
          'hobby', 'school', 'favoritePlace', 'hometown', 'currentCity',
          'work', 'education', 'relationshipStatus', 'interests',
          'photoUrl', 'coverPhotoUrl', 'photoOriginalUrl',
          'coverPhotoOriginalUrl', 'photoOriginalPath', 'coverPhotoOriginalPath'
        ])
        && request.resource.data.keys().hasOnly(allowedUserFields());
      allow delete: if owns(userId);

      // Each signed-in user can manage only their own device push tokens.
      // Cloud Functions Admin SDK reads these tokens server-side.
      match /savedPosts/{postId} {
        allow read, delete: if owns(userId);
        allow create, update: if owns(userId)
          && request.resource.data.postId == postId
          && request.resource.data.ownerUid is string
          && request.resource.data.keys().hasOnly(['postId', 'ownerUid', 'savedAt']);
      }

      match /fcmTokens/{tokenId} {
        allow read: if owns(userId);
        allow create, update: if owns(userId)
          && request.resource.data.token == tokenId
          && request.resource.data.platform == 'android'
          && request.resource.data.keys().hasOnly(['token', 'platform', 'updatedAt']);
        allow delete: if owns(userId);
      }
    }

    // Public directory contains only fields safe to show to signed-in users.
    // Never put email, phone, date of birth, gender, or other private details here.
    match /publicProfiles/{userId} {
      function isAcceptedFriend() {
        return signedIn()
          && exists(/databases/$(database)/documents/friends/$(userId)/list/$(request.auth.uid))
          && (
            (exists(/databases/$(database)/documents/friendRequests/$(userId + '_' + request.auth.uid))
              && get(/databases/$(database)/documents/friendRequests/$(userId + '_' + request.auth.uid)).data.status == 'accepted')
            || (exists(/databases/$(database)/documents/friendRequests/$(request.auth.uid + '_' + userId))
              && get(/databases/$(database)/documents/friendRequests/$(request.auth.uid + '_' + userId)).data.status == 'accepted')
          );
      }
      // Missing visibility is denied by default; legacy profiles must be explicitly marked public.
      allow read: if signedIn() && (
        owns(userId)
        || isAcceptedFriend()
        || resource.data.profileVisibility == "public"
      );
      allow create: if owns(userId)
        && request.resource.data.keys().hasOnly([
          'uid', 'displayName', 'username', 'photoUrl', 'coverPhotoUrl', 'photoOriginalUrl', 'coverPhotoOriginalUrl', 'photoOriginalPath', 'coverPhotoOriginalPath', 'bio', 'hobby', 'school', 'favoritePlace', 'hometown', 'currentCity', 'work', 'education', 'relationshipStatus', 'interests', 'profileVisibility', 'updatedAt', 'createdAt'
        ])
        && request.resource.data.uid == userId;
      allow update: if owns(userId)
        && request.resource.data.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'uid', 'displayName', 'username', 'photoUrl', 'coverPhotoUrl', 'photoOriginalUrl', 'coverPhotoOriginalUrl', 'photoOriginalPath', 'coverPhotoOriginalPath', 'bio', 'hobby', 'school', 'favoritePlace', 'hometown', 'currentCity', 'work', 'education', 'relationshipStatus', 'interests', 'profileVisibility', 'isOnline', 'lastSeen', 'updatedAt'
        ])
        // Permit deletion of legacy presence fields only; never permit them to remain.
        && !request.resource.data.keys().hasAny(['isOnline', 'lastSeen']);
      allow delete: if owns(userId);
    }

    // Minimal discoverability card for every account, including private profiles.
    // Contains only name, username, avatar, cover and visibility; no bio or personal details.
    match /profileDirectory/{userId} {
      // Directory metadata remains discoverable, but private-profile bearer
      // photo URLs must never be stored in this broadly readable document.
      allow read: if signedIn();
      allow create: if owns(userId)
        && request.resource.data.uid == userId
        && request.resource.data.keys().hasOnly([
          'uid', 'displayName', 'username', 'photoUrl', 'coverPhotoUrl',
          'profileVisibility', 'updatedAt'
        ])
        && (request.resource.data.profileVisibility == 'public'
          || !request.resource.data.keys().hasAny(['photoUrl', 'coverPhotoUrl']));
      allow update: if owns(userId)
        && resource.data.uid == userId
        && request.resource.data.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'uid', 'displayName', 'username', 'photoUrl', 'coverPhotoUrl',
          'profileVisibility', 'updatedAt'
        ])
        && (request.resource.data.profileVisibility == 'public'
          || !request.resource.data.keys().hasAny(['photoUrl', 'coverPhotoUrl']));
      allow delete: if owns(userId);
    }

    // Presence is isolated from the signed-in-readable profile directory.
    // Only the owner and accepted friends can read a user's presence document.
    match /profilePresence/{userId} {
      function isAcceptedFriend() {
        return signedIn()
          && exists(/databases/$(database)/documents/friends/$(userId)/list/$(request.auth.uid))
          && (
            (exists(/databases/$(database)/documents/friendRequests/$(userId + '_' + request.auth.uid))
              && get(/databases/$(database)/documents/friendRequests/$(userId + '_' + request.auth.uid)).data.status == 'accepted')
            || (exists(/databases/$(database)/documents/friendRequests/$(request.auth.uid + '_' + userId))
              && get(/databases/$(database)/documents/friendRequests/$(request.auth.uid + '_' + userId)).data.status == 'accepted')
          );
      }
      allow get: if owns(userId) || isAcceptedFriend();
      allow list: if false;
      allow create, update: if owns(userId)
        && request.resource.data.uid == userId
        && request.resource.data.keys().hasOnly(['uid', 'isOnline', 'lastSeen', 'updatedAt']);
      allow delete: if owns(userId);
    }

    // Username reservations: one document per normalized username.
    // A user can only reserve a name for their own account.
    match /usernameClaims/{username} {
      // The app checks a single username claim; do not allow listing all claims.
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.username == username
        && username.matches('^[a-z0-9_.]{4,20}$')
        && request.resource.data.keys().hasOnly(['uid', 'username', 'createdAt']);
      allow update: if owns(resource.data.uid)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.username == username
        && request.resource.data.keys().hasOnly(['uid', 'username', 'createdAt']);
      allow delete: if owns(resource.data.uid);
    }

    match /phoneAuthCredentials/{credentialId} {
      allow read, write: if false;
    }

    // Story media is visible only to its owner, accepted friends, or public-profile viewers.
    match /stories/{storyId} {
      allow read: if canReadStory(resource.data) && resource.data.expiresAt is timestamp && resource.data.expiresAt > request.time;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          'uid', 'authorName', 'mediaUrl', 'mediaType', 'storagePath', 'createdAt', 'expiresAt'
        ])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.authorName is string
        && request.resource.data.authorName.size() > 0
        && request.resource.data.authorName.size() <= 80
        && request.resource.data.mediaUrl is string
        && request.resource.data.mediaUrl.size() <= 4096
        && request.resource.data.mediaType in ['image', 'video']
        && request.resource.data.createdAt == request.time
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt > request.time
        && request.resource.data.expiresAt <= request.time + duration.value(24, 'h') + duration.value(5, 'm')
        && (!('storagePath' in request.resource.data)
          || (request.resource.data.storagePath is string
            && (request.resource.data.storagePath == ''
              || request.resource.data.storagePath.matches('^stories/' + request.auth.uid + '/[A-Za-z0-9_.-]{1,180}')
              || request.resource.data.storagePath.matches('^reels/' + request.auth.uid + '/[A-Za-z0-9_.-]{1,180}'))))
        && (request.resource.data.mediaUrl.size() > 0
          || (request.resource.data.storagePath is string && request.resource.data.storagePath.size() > 0));
      allow update: if false;
      allow delete: if owns(resource.data.uid);
    }

    match /posts/{postId} {
      // Enforce each post's audience and the author's profile visibility.
      allow read: if canReadPost(resource.data);
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.authorName is string
        && request.resource.data.authorName.size() > 0
        && request.resource.data.authorName.size() <= 80
        && (!('audience' in request.resource.data)
          || request.resource.data.audience in ['public', 'friends', 'private'])
        && (!('text' in request.resource.data)
          || (request.resource.data.text is string && request.resource.data.text.size() <= 5000))
        && (!('mediaUrl' in request.resource.data)
          || (request.resource.data.mediaUrl is string && request.resource.data.mediaUrl.size() <= 4096))
        && (!('storagePath' in request.resource.data)
          || (request.resource.data.storagePath is string
            && (request.resource.data.storagePath == ''
              || request.resource.data.storagePath.matches('^post_photos/' + request.auth.uid + '/[A-Za-z0-9_.-]{1,180}')
              || request.resource.data.storagePath.matches('^reels/' + request.auth.uid + '/[A-Za-z0-9_.-]{1,180}'))))
        && ((('text' in request.resource.data) && request.resource.data.text.size() > 0)
          || (('mediaUrl' in request.resource.data) && request.resource.data.mediaUrl.size() > 0)
          || (('storagePath' in request.resource.data) && request.resource.data.storagePath is string && request.resource.data.storagePath.size() > 0));

      // A post's owner identity and audience cannot be changed by editing it.
      allow update: if owns(resource.data.uid)
        && request.resource.data.uid == resource.data.uid
        && (!('audience' in request.resource.data)
          || request.resource.data.audience in ['public', 'friends', 'private'])
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'authorName', 'text', 'mediaUrl', 'mediaType', 'postType', 'audience',
          'location', 'taggedUsers', 'overlayText', 'sticker', 'effect',
          'originalAudioMuted', 'updatedAt'
        ]);
      allow delete: if owns(resource.data.uid);

      match /likes/{likerId} {
        // Parent post access is required before reading or changing reactions.
        allow read: if exists(/databases/$(database)/documents/posts/$(postId))
          && canReadPost(get(/databases/$(database)/documents/posts/$(postId)).data);
        allow create: if owns(likerId)
          && exists(/databases/$(database)/documents/posts/$(postId))
          && canReadPost(get(/databases/$(database)/documents/posts/$(postId)).data)
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.reaction in ['👍', '❤️', '😂', '😢', '😡'];
        allow update: if owns(likerId)
          && exists(/databases/$(database)/documents/posts/$(postId))
          && canReadPost(get(/databases/$(database)/documents/posts/$(postId)).data)
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.reaction in ['👍', '❤️', '😂', '😢', '😡']
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reaction', 'createdAt']);
        allow delete: if owns(likerId)
        && exists(/databases/$(database)/documents/posts/$(postId))
        && canReadPost(get(/databases/$(database)/documents/posts/$(postId)).data);
      }
      match /comments/{commentId} {
        allow read: if exists(/databases/$(database)/documents/posts/$(postId))
          && canReadPost(get(/databases/$(database)/documents/posts/$(postId)).data);
        allow create: if signedIn()
          && exists(/databases/$(database)/documents/posts/$(postId))
          && canReadPost(get(/databases/$(database)/documents/posts/$(postId)).data)
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 1000
          && request.resource.data.parentId == postId;
        allow update: if signedIn()
          && exists(/databases/$(database)/documents/posts/$(postId))
          && canReadPost(get(/databases/$(database)/documents/posts/$(postId)).data)
          && resource.data.uid == request.auth.uid
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.parentId == resource.data.parentId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'updatedAt']);
        allow delete: if signedIn()
          && exists(/databases/$(database)/documents/posts/$(postId))
          && canReadPost(get(/databases/$(database)/documents/posts/$(postId)).data)
          && resource.data.uid == request.auth.uid;
      }
    }

    match /postReports/{reportId} {
      allow create: if signedIn()
        && request.resource.data.reporterUid == request.auth.uid
        && request.resource.data.postId is string
        && request.resource.data.postOwnerUid is string
        && request.resource.data.keys().hasOnly(['postId', 'postOwnerUid', 'reporterUid', 'createdAt']);
      allow read, update, delete: if false;
    }

    match /friendRequests/{requestId} {
      // The profile screen listens to both deterministic request IDs. One
      // direction is normally absent, so authorize that exact pair lookup too;
      // otherwise reading a non-existent request is denied before Unfriend opens.
      allow read: if signedIn()
        && (
          requestId.matches('^' + request.auth.uid + '_[^_]+$')
          || requestId.matches('^[^_]+_' + request.auth.uid + '$')
          || resource.data.fromUid == request.auth.uid
          || resource.data.toUid == request.auth.uid
        );
      allow create: if signedIn()
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.toUid is string
        && request.resource.data.toUid != request.auth.uid
        && request.resource.data.status == 'pending';
      allow update: if signedIn() && (
        // Recipient can accept or reject a pending request.
        (resource.data.toUid == request.auth.uid
          && resource.data.status == 'pending'
          && request.resource.data.fromUid == resource.data.fromUid
          && request.resource.data.toUid == resource.data.toUid
          && request.resource.data.status in ['accepted', 'rejected']
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']))
        // Either participant can revoke an accepted friendship.
        || ((resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid)
          && resource.data.status == 'accepted'
          && request.resource.data.fromUid == resource.data.fromUid
          && request.resource.data.toUid == resource.data.toUid
          && request.resource.data.status == 'rejected'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']))
        // Original sender can resend a rejected request.
        || (resource.data.fromUid == request.auth.uid
          && resource.data.status == 'rejected'
          && request.resource.data.fromUid == resource.data.fromUid
          && request.resource.data.toUid == resource.data.toUid
          && request.resource.data.status == 'pending'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']))
      );
      allow delete: if signedIn()
        && (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid);
    }

    match /friends/{userId}/list/{friendId} {
      function hasAcceptedRequest() {
        return (exists(/databases/$(database)/documents/friendRequests/$(userId + '_' + friendId))
          && getAfter(/databases/$(database)/documents/friendRequests/$(userId + '_' + friendId)).data.status == 'accepted')
          || (exists(/databases/$(database)/documents/friendRequests/$(friendId + '_' + userId))
          && getAfter(/databases/$(database)/documents/friendRequests/$(friendId + '_' + userId)).data.status == 'accepted');
      }
      allow read: if owns(userId);
      allow create, update: if signedIn()
        && (request.auth.uid == userId || request.auth.uid == friendId)
        && hasAcceptedRequest();
      // Either participant can remove the friendship from both users' lists.
      allow delete: if signedIn()
        && (owns(userId) || request.auth.uid == friendId);
    }

    match /chats/{chatId} {
      allow read: if signedIn() && request.auth.uid in resource.data.participantIds;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          'participantIds', 'updatedAt', 'lastMessage', 'lastMessageAt', 'lastSenderUid',
          'autoDeleteSeconds', 'autoDeleteLabel',
          'lastReadAt_' + request.auth.uid, 'unreadCount_' + request.auth.uid
        ])
        && request.resource.data.participantIds is list
        && request.resource.data.participantIds.size() == 2
        && request.resource.data.participantIds[0] != request.resource.data.participantIds[1]
        && request.auth.uid in request.resource.data.participantIds
        && canStartChat(request.resource.data.participantIds[0], request.resource.data.participantIds[1]);
      allow update: if signedIn()
        && request.auth.uid in resource.data.participantIds
        && request.resource.data.participantIds == resource.data.participantIds
        && (!('lastSenderUid' in request.resource.data) || request.resource.data.lastSenderUid == request.auth.uid)
        && (!('lastMessage' in request.resource.data) || (request.resource.data.lastMessage is string && request.resource.data.lastMessage.size() <= 4000))
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'updatedAt', 'lastMessage', 'lastMessageAt', 'lastSenderUid',
          'autoDeleteSeconds', 'autoDeleteLabel',
          'lastReadAt_' + request.auth.uid,
          'unreadCount_' + request.auth.uid
        ])
        && (!('autoDeleteSeconds' in request.resource.data)
          || request.resource.data.autoDeleteSeconds in [0, 86400, 604800, 1296000, 2592000]);
      match /messages/{messageId} {
        function isChatParticipant() {
          return signedIn()
            && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participantIds;
        }
        allow read: if isChatParticipant();
        allow create: if isChatParticipant()
          && request.resource.data.keys().hasOnly(['uid', 'text', 'createdAt', 'expireAt'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 4000
          && (!('expireAt' in request.resource.data)
            || (request.resource.data.expireAt is timestamp
              && request.resource.data.expireAt > request.time
              && request.resource.data.expireAt <= request.time + duration.value(30, 'd')));
        allow update: if false;
        allow delete: if isChatParticipant() && resource.data.uid == request.auth.uid;
      }
    }
    // WebRTC call signalling. Firestore stores call metadata, SDP and ICE
    // candidates; audio/video media is not stored in Firestore.
    match /callSessions/{callId} {
      function isParticipant() {
        return signedIn()
          && (request.auth.uid == resource.data.callerUid
            || request.auth.uid == resource.data.calleeUid);
      }
      function isCaller() {
        return signedIn() && request.auth.uid == resource.data.callerUid;
      }
      function isCallee() {
        return signedIn() && request.auth.uid == resource.data.calleeUid;
      }
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          'callerUid', 'calleeUid', 'status', 'callType', 'offer', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.callerUid == request.auth.uid
        && request.resource.data.calleeUid is string
        && request.resource.data.calleeUid != request.auth.uid
        && areAcceptedFriends(request.auth.uid, request.resource.data.calleeUid)
        && request.resource.data.status == 'ringing'
        && request.resource.data.callType in ['audio', 'video'];
      allow read: if isParticipant();
      allow update: if isParticipant()
        && request.resource.data.callerUid == resource.data.callerUid
        && request.resource.data.calleeUid == resource.data.calleeUid
        && request.resource.data.callType == resource.data.callType
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'offer', 'answer', 'updatedAt', 'endedAt', 'acceptedAt'
        ])
        && (
          (isCaller()
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['offer', 'status', 'updatedAt', 'endedAt'])
            && (request.resource.data.status == resource.data.status
              || request.resource.data.status == 'ended'))
          ||
          (isCallee()
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['answer', 'status', 'updatedAt', 'acceptedAt', 'endedAt'])
            && (request.resource.data.status == resource.data.status
              || request.resource.data.status in ['accepted', 'rejected', 'ended', 'missed']))
        );
      allow delete: if false;

      match /callerCandidates/{candidateId} {
        function callParticipant() {
          let call = get(/databases/$(database)/documents/callSessions/$(callId)).data;
          return signedIn() && (request.auth.uid == call.callerUid || request.auth.uid == call.calleeUid);
        }
        allow read: if callParticipant();
        allow create: if signedIn()
          && request.auth.uid == get(/databases/$(database)/documents/callSessions/$(callId)).data.callerUid
          && request.resource.data.keys().hasOnly(['sdpMid', 'sdpMLineIndex', 'candidate', 'createdAt'])
          && request.resource.data.candidate is string;
        allow update, delete: if false;
      }
      match /calleeCandidates/{candidateId} {
        function callParticipant() {
          let call = get(/databases/$(database)/documents/callSessions/$(callId)).data;
          return signedIn() && (request.auth.uid == call.callerUid || request.auth.uid == call.calleeUid);
        }
        allow read: if callParticipant();
        allow create: if signedIn()
          && request.auth.uid == get(/databases/$(database)/documents/callSessions/$(callId)).data.calleeUid
          && request.resource.data.keys().hasOnly(['sdpMid', 'sdpMLineIndex', 'candidate', 'createdAt'])
          && request.resource.data.candidate is string;
        allow update, delete: if false;
      }
    }

  }
}
