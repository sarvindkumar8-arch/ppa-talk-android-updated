rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Phone/password credentials are server-only; never expose password hashes to clients.
    match /phoneAuthCredentials/{credentialId} {
      allow read, write: if false;
    }
    match /users/{userId} {
      allow read: if true;
      allow create: if request.auth != null
                    && request.auth.uid == userId
                    && request.resource.data.uid == userId
                    && request.resource.data.visibility == 'public';
      allow update: if request.auth != null
                    && request.auth.uid == userId
                    && request.resource.data.uid == resource.data.uid;
      allow delete: if request.auth != null && request.auth.uid == userId;
    }
    match /posts/{postId} {
      allow read: if true;
      allow create: if request.auth != null
                    && request.resource.data.uid == request.auth.uid
                    && ((request.resource.data.text is string
                         && request.resource.data.text.size() <= 5000)
                        || (request.resource.data.mediaUrl is string
                            && request.resource.data.mediaUrl.size() > 0));
      allow update, delete: if request.auth != null
                            && resource.data.uid == request.auth.uid;

      match /likes/{likerId} {
        allow read: if true;
        allow create: if request.auth != null
                      && request.auth.uid == likerId
                      && request.resource.data.uid == request.auth.uid;
        allow delete: if request.auth != null && request.auth.uid == likerId;
      }

      match /comments/{commentId} {
        allow read: if true;
        allow create: if request.auth != null
                      && request.resource.data.uid == request.auth.uid
                      && request.resource.data.text is string
                      && request.resource.data.text.size() > 0
                      && request.resource.data.text.size() <= 1000
                      && request.resource.data.parentId is string;
        allow update, delete: if request.auth != null
                              && resource.data.uid == request.auth.uid;
      }
    }

    match /friendRequests/{requestId} {
      allow read: if request.auth != null
                  && (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid);
      allow create: if request.auth != null
                    && request.resource.data.fromUid == request.auth.uid
                    && request.resource.data.toUid is string
                    && request.resource.data.toUid != request.auth.uid
                    && request.resource.data.status == 'pending';
      allow update: if request.auth != null
                    && resource.data.toUid == request.auth.uid
                    && request.resource.data.fromUid == resource.data.fromUid
                    && request.resource.data.toUid == resource.data.toUid
                    && request.resource.data.status in ['accepted', 'rejected'];
      allow delete: if request.auth != null
                    && (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid);
    }

    match /friends/{userId}/list/{friendId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create, update, delete: if request.auth != null && request.auth.uid == userId;
    }

    match /chats/{chatId} {
      allow read: if request.auth != null && request.auth.uid in resource.data.participantIds;
      allow create: if request.auth != null
                    && request.auth.uid in request.resource.data.participantIds
                    && request.resource.data.participantIds is list
                    && request.resource.data.participantIds.size() == 2;
      allow update: if request.auth != null
                    && request.auth.uid in resource.data.participantIds
                    && request.resource.data.participantIds == resource.data.participantIds;

      match /messages/{messageId} {
        function isChatParticipant() {
          return request.auth != null
                 && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participantIds;
        }
        allow read: if isChatParticipant();
        allow create: if isChatParticipant()
                      && request.resource.data.uid == request.auth.uid
                      && request.resource.data.text is string
                      && request.resource.data.text.size() > 0
                      && request.resource.data.text.size() <= 4000;
        allow update, delete: if false;
      }
    }
  }
}
