rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function owns(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function profileDoc(uid) {
      return firestore.get(/databases/(default)/documents/publicProfiles/$(uid));
    }

    function profileIsPublic(uid) {
      return firestore.exists(/databases/(default)/documents/publicProfiles/$(uid))
        && profileDoc(uid).data.profileVisibility == 'public';
    }

    function isAcceptedFriend(uid) {
      let friendEntry = /databases/(default)/documents/friends/$(uid)/list/$(request.auth.uid);
      let outgoing = /databases/(default)/documents/friendRequests/$(uid + '_' + request.auth.uid);
      let incoming = /databases/(default)/documents/friendRequests/$(request.auth.uid + '_' + uid);
      return signedIn()
        && firestore.exists(friendEntry)
        && (
          (firestore.exists(outgoing) && firestore.get(outgoing).data.status == 'accepted')
          || (firestore.exists(incoming) && firestore.get(incoming).data.status == 'accepted')
        );
    }

    function canReadProfileMedia(uid) {
      return signedIn() && (
        owns(uid)
        || profileIsPublic(uid)
        || isAcceptedFriend(uid)
      );
    }

    match /profile_photos/{uid}/{fileName} {
      allow read: if canReadProfileMedia(uid);
      allow create, update: if owns(uid)
        && request.resource != null
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if owns(uid);
    }

    match /cover_photos/{uid}/{fileName} {
      allow read: if canReadProfileMedia(uid);
      allow create, update: if owns(uid)
        && request.resource != null
        && request.resource.size < 15 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if owns(uid);
    }

    // Post/story/reel visibility remains authenticated-user based until
    // their document-level audience model is audited and migrated.
    match /post_photos/{uid}/{fileName} {
      allow read: if signedIn();
      allow create, update: if owns(uid)
        && request.resource != null
        && request.resource.size < 25 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if owns(uid);
    }

    match /stories/{uid}/{fileName} {
      allow read: if signedIn();
      allow create, update: if owns(uid)
        && request.resource != null
        && request.resource.size < 100 * 1024 * 1024
        && request.resource.contentType.matches('(image|video)/.*');
      allow delete: if owns(uid);
    }

    match /reels/{uid}/{fileName} {
      allow read: if signedIn();
      allow create, update: if owns(uid)
        && request.resource != null
        && request.resource.size < 100 * 1024 * 1024
        && request.resource.contentType.matches('video/.*');
      allow delete: if owns(uid);
    }
  }
}