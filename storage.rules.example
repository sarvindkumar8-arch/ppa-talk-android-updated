rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null; }
    function owns(uid) { return signedIn() && request.auth.uid == uid; }

    function profileDocPath(uid) {
      return /databases/(default)/documents/publicProfiles/$(uid);
    }
    function isPublicProfile(uid) {
      return firestore.exists(profileDocPath(uid))
        && firestore.get(profileDocPath(uid)).data.profileVisibility == "public";
    }
    function isAcceptedFriend(uid) {
      let friendPath = /databases/(default)/documents/friends/$(uid)/list/$(request.auth.uid);
      let forwardRequest = /databases/(default)/documents/friendRequests/$(uid + '_' + request.auth.uid);
      let reverseRequest = /databases/(default)/documents/friendRequests/$(request.auth.uid + '_' + uid);
      return signedIn() && firestore.exists(friendPath)
        && ((firestore.exists(forwardRequest) && firestore.get(forwardRequest).data.status == "accepted")
          || (firestore.exists(reverseRequest) && firestore.get(reverseRequest).data.status == "accepted"));
    }
    function canReadProfileMedia(uid) {
      return signedIn() && (owns(uid) || isPublicProfile(uid) || isAcceptedFriend(uid));
    }

    // Validate both declared MIME type and filename extension. These checks are
    // defense-in-depth; Firebase Storage Rules cannot inspect actual file bytes.
    function validImageUpload(maxBytes) {
      return request.resource.size < maxBytes
        && request.resource.contentType in ['image/jpeg', 'image/png', 'image/webp']
        && fileName.matches('^[A-Za-z0-9_-]+\\.(jpg|jpeg|png|webp)$');
    }
    function validStoryUpload() {
      return request.resource.size < 100 * 1024 * 1024
        && ((request.resource.contentType in ['image/jpeg', 'image/png', 'image/webp']
             && fileName.matches('^[A-Za-z0-9_-]+\\.(jpg|jpeg|png|webp)$'))
          || (request.resource.contentType == 'video/mp4'
             && fileName.matches('^[A-Za-z0-9_-]+\\.mp4$')));
    }
    function validReelUpload() {
      return request.resource.size < 100 * 1024 * 1024
        && request.resource.contentType == 'video/mp4'
        && fileName.matches('^[A-Za-z0-9_-]+\\.mp4$');
    }

    match /profile_photos/{uid}/{fileName} {
      allow read: if canReadProfileMedia(uid) && !fileName.matches('^original_.*');
      allow create, update: if owns(uid) && validImageUpload(10 * 1024 * 1024);
      allow delete: if owns(uid);
    }
    match /cover_photos/{uid}/{fileName} {
      allow read: if canReadProfileMedia(uid) && !fileName.matches('^original_.*');
      allow create, update: if owns(uid) && validImageUpload(15 * 1024 * 1024);
      allow delete: if owns(uid);
    }
    match /post_photos/{uid}/{fileName} {
      // Direct reads remain denied; use the authenticated secure-media flow.
      allow read: if false;
      allow create, update: if owns(uid) && validImageUpload(25 * 1024 * 1024);
      allow delete: if owns(uid);
    }
    match /stories/{uid}/{fileName} {
      allow read: if false;
      allow create, update: if owns(uid) && validStoryUpload();
      allow delete: if owns(uid);
    }
    match /reels/{uid}/{fileName} {
      allow read: if false;
      allow create, update: if owns(uid) && validReelUpload();
      allow delete: if owns(uid);
    }
  }
}
